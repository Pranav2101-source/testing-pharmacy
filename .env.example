# ─── Database ───────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/pharmacy_db?sslmode=require"

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Meilisearch ─────────────────────────────────────────────
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="your-meilisearch-master-key"

# ─── Auth ────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-secret-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Cloudflare R2 ───────────────────────────────────────────
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key"
R2_SECRET_ACCESS_KEY="your-secret-key"
R2_BUCKET_NAME="pharmacy-uploads"
R2_PUBLIC_URL="https://your-bucket.r2.dev"

# ─── App ─────────────────────────────────────────────────────
API_PORT=4000
API_HOST="0.0.0.0"
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# ─── Razorpay ────────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_xxxxx"
RAZORPAY_KEY_SECRET="your-secret"

# ─── GST ─────────────────────────────────────────────────────
GST_API_URL="https://api.cleartax.in"
GST_API_KEY="your-gst-api-key"
