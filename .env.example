# ─── Database (Supabase) ─────────────────────────────────────────────────────
# Supabase dashboard → Settings → Database → Connection string
#
# DATABASE_URL  : Transaction pooler  (port 6543) — used by Prisma at runtime
# DIRECT_URL    : Direct connection (db.<ref>.supabase.co:5432) — used by Prisma migrations
#                 only; may be blocked by ISP firewalls on home networks
# PGBOSS_URL    : Session mode pooler (pooler host, port 5432) — used by pg-boss
#                 (needs LISTEN/NOTIFY; transaction pooler doesn't support it;
#                  direct connection is often ISP-blocked)
#
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres?sslmode=require"
PGBOSS_URL="postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ─── Supabase Storage ────────────────────────────────────────────────────────
# Supabase dashboard → Settings → API
# Use the SERVICE ROLE key (secret) — never expose this to the frontend.
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_STORAGE_BUCKET="pharmacy-docs"

# ─── Redis ───────────────────────────────────────────────────────────────────
# Local dev: Redis runs in Docker (docker compose up -d), so localhost:6379.
# Production (AWS): ElastiCache endpoint, e.g. redis://my-cluster.abc.cache.amazonaws.com:6379
REDIS_URL="redis://localhost:6379"

# ─── Meilisearch ─────────────────────────────────────────────────────────────
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="your-meilisearch-master-key"

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-secret-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── App ─────────────────────────────────────────────────────────────────────
API_PORT=4000
API_HOST="0.0.0.0"
NODE_ENV="development"
ALLOWED_ORIGINS="http://localhost:3000"

# ─── Razorpay ────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_xxxxx"
RAZORPAY_KEY_SECRET="your-secret"

# ─── SMTP (optional — required for password reset emails in production) ───────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your@email.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@checkup.app"
