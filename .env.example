# ─── Database (Supabase) ─────────────────────────────────────────────────────
# Supabase dashboard → Settings → Database → Connection string
#
# DATABASE_URL : Transaction pooler (port 6543) — used by Prisma (schema owner)
# DIRECT_URL   : Direct connection (db.<ref>.supabase.co:5432) — used by Prisma
#                migrations only; may be blocked by ISP firewalls on home networks
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres?sslmode=require"

# ─── API datasource (JDBC) ───────────────────────────────────────────────────
# The JDBC form of the pooler URL for the Spring Boot API. Note:
#   - the "jdbc:" prefix
#   - prepareThreshold=0 is REQUIRED for the Supabase pgbouncer transaction pooler
#     (server-side prepared statements are not supported in that mode)
JDBC_DATABASE_URL="jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0"
DB_USER="postgres.xxxx"
DB_PASSWORD="password"

# ─── Auth ────────────────────────────────────────────────────────────────────
# HS256 secret for signing/verifying access + refresh tokens (min 32 chars).
JWT_SECRET="change-this-to-a-long-random-secret-min-32-chars"

# ─── Supabase Storage ────────────────────────────────────────────────────────
# Use the SERVICE ROLE key (secret) — never expose this to the frontend.
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_STORAGE_BUCKET="pharmacy-docs"

# ─── Redis ───────────────────────────────────────────────────────────────────
# Local dev: Redis runs in Docker (docker compose up -d), so localhost:6379.
REDIS_URL="redis://localhost:6379"

# ─── Meilisearch (search — used once the search module is built) ─────────────
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="your-meilisearch-master-key"

# ─── Transactional email (password-reset / notification emails) ──────────────
# Sent via Resend's HTTPS API — see apps/api-java/.../common/mail/EmailService.java.
# Leave either of the first two blank and the mailer logs a warning and skips the
# send instead of failing, so dev and CI run without mail credentials.
#
# EMAIL_FROM must be on a domain verified in the Resend account (checkup.care).
# Resend rejects any other sender with a 403 domain-verification error.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=

# Base URL used to build the password-reset link in outgoing email.
APP_URL=

# Recipient for scripts/send-test-email.mjs (one-off key check).
TEST_EMAIL_TO=

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=8080
ALLOWED_ORIGINS="http://localhost:5173"

# ─── Web (Vite) ──────────────────────────────────────────────────────────────
# Same-origin path; Vercel/dev proxy rewrites /api to the API service.
VITE_API_URL="/api/v1"
