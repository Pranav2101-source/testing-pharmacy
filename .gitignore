# Dependencies
node_modules

# Environment — NEVER commit these
.env
.env.local
.env.*.local
.env.production
.env.staging
.env.migrate
**/.env
**/.env.local
**/.env.migrate

# Build outputs
dist
.next
.turbo

# TypeScript compiled artifacts that accidentally land inside src/ directories.
# tsc --outDir should point to dist/, but sometimes a stray build drops .js/.d.ts
# next to source files. These are never authoritative — dist/ is the output.
apps/api/src/**/*.js
apps/api/src/**/*.js.map
apps/api/src/**/*.d.ts
apps/api/src/**/*.d.ts.map

# Logs
*.log
logs/

# Test coverage
coverage

# Playwright (e2e run artifacts)
playwright-report/
test-results/
blob-report/

# OS
.DS_Store
Thumbs.db

# Certs & keys
*.pem
*.key
*.cert

# Deployment
.vercel

# Prisma dev migrations
prisma/migrations/dev

# Medicine import data (large files — not for git)
scripts/data/*.csv
scripts/data/*.xlsx
scripts/data/import-report.txt

# User-uploaded files (support attachments, prescriptions) — may contain
# customer PHI; must NEVER be committed
apps/api/uploads/
/uploads/

# Client data exported from their previous system, staged for migration —
# real business data; must NEVER be committed
/client-data/

# Local dev seed script with hardcoded credentials
apps/api/scripts/_seed-admin.ts
.env*
