}

enum ReturnDisposition {
  RESTOCK
  WRITEOFF
}

model SalesReturnItem {
  id            String            @id @default(cuid())
  pharmacyId    String
  returnId      String
  invoiceItemId String?
  inventoryId   String
  medicineName  String
  hsnCode       String?
  batchNumber   String
  expiryDate    DateTime
  quantity      Int
  mrp           Decimal           @db.Decimal(12, 2)
  rate          Decimal           @db.Decimal(12, 2)
  discount      Decimal           @default(0) @db.Decimal(12, 2)
  gstRate       Decimal           @db.Decimal(12, 2)
  cgst          Decimal           @db.Decimal(12, 2)
  sgst          Decimal           @db.Decimal(12, 2)
  igst          Decimal           @default(0) @db.Decimal(12, 2)
  taxableAmount Decimal           @db.Decimal(12, 2)
  amount        Decimal           @db.Decimal(12, 2)
  disposition   ReturnDisposition @default(RESTOCK)

  pharmacy    Pharmacy     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  return      SalesReturn  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  inventory   Inventory    @relation(fields: [inventoryId], references: [id])
  invoiceItem InvoiceItem? @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)

  @@index([pharmacyId])
  @@index([returnId])
  @@index([inventoryId])
  @@index([invoiceItemId])
  @@map("sales_return_items")
}

// ─── Inventory Movement (full stock ledger) ───────────────────────────────────
// Append-only. Every stock change writes one record here for full reconciliation.

model InventoryMovement {
  id             String            @id @default(cuid())
  pharmacyId     String
  inventoryId    String
  userId         String
  type           MovementType
  direction      MovementDirection
  quantity       Int
  quantityBefore Int
  quantityAfter  Int
  // Valid values (enforced by DB CHECK): GRN | INVOICE | INVOICE_CANCEL | SALES_RETURN |
  // SUPPLIER_RETURN | BATCH_RECALL | STATUS_CHANGE | STOCK_AUDIT |
  // CORRECTION | DAMAGE | EXPIRY_WRITEOFF | OPENING_BALANCE | TRANSFER | THEFT | BREAKAGE | STOCK_COUNT | OTHER
  referenceType  String?
  referenceId    String?
  notes          String?

  createdAt DateTime @default(now())

  pharmacy  Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  inventory Inventory @relation(fields: [inventoryId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([pharmacyId, inventoryId])
  @@index([pharmacyId, createdAt])
  @@index([referenceId])
  // Covering index for ledger filtered by movement type (sale/purchase/adjustment history views)
  @@index([pharmacyId, type, createdAt(sort: Desc)])
  // User-wise stock movement audit
  @@index([pharmacyId, userId, createdAt(sort: Desc)])
  // AI sales-velocity: getMedicineDailySales JOINs on inventoryId then filters
  // direction+type+createdAt — without this Postgres scans all movements per batch.
  @@index([inventoryId, direction, type, createdAt(sort: Desc)])
  @@map("inventory_movements")
}

enum MovementType {
  SALE
  RETURN
  PURCHASE
  ADJUSTMENT
  OPENING
  DAMAGE
  EXPIRY_REMOVAL
}

enum MovementDirection {
  IN
  OUT
}

// InvoiceSettings table removed — inlined into Pharmacy.invoiceSettings (Json).
// Was a strict 1:1 (pharmacyId @unique) holding one JSON blob, read only by
// pharmacyId and written via upsert; a separate table added a join for nothing.

// ─── Audit Log ───────────────────────────────────────────────────────────────

enum AuditModule {
  AUTH
  TENANTS
  SUBSCRIPTIONS
  SUPPORT
  SETTINGS
  SYSTEM
  ANALYTICS
  AUDIT
  BILLING
  INVENTORY
}

enum AuditSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum AuditStatus {
  SUCCESS
  FAILED
  PENDING
}

model AuditLog {
  id           String        @id @default(cuid())
  pharmacyId   String?
  userId       String?
  userEmail    String?
  module       AuditModule   @default(SYSTEM)
  action       String
  entity       String
  entityId     String?
  resourceName String?
  oldData      Json?
  newData      Json?
  ipAddress    String?
  userAgent    String?
  severity     AuditSeverity @default(INFO)
  status       AuditStatus   @default(SUCCESS)
  requestId    String?

  createdAt DateTime @default(now())

  pharmacy Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
