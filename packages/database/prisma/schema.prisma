// ─── Day-end cash closure ─────────────────────────────────────────────────────

enum ClosureStatus {
  DRAFT
  CLOSED
  DISPUTED
}

model CashClosure {
  id           String        @id @default(cuid())
  pharmacyId   String
  userId       String
  closureDate  DateTime      @db.Date
  openingCash  Decimal       @default(0) @db.Decimal(12, 2)
  cashSales    Decimal       @default(0) @db.Decimal(12, 2)
  upiSales     Decimal       @default(0) @db.Decimal(12, 2)
  cardSales    Decimal       @default(0) @db.Decimal(12, 2)
  creditSales  Decimal       @default(0) @db.Decimal(12, 2)
  walletSales  Decimal       @default(0) @db.Decimal(12, 2)
  expectedCash Decimal       @default(0) @db.Decimal(12, 2)
  actualCash   Decimal       @default(0) @db.Decimal(12, 2)
  variance     Decimal       @default(0) @db.Decimal(12, 2)
