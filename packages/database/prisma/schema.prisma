// ─── Notification Log ────────────────────────────────────────────────────────

model NotificationLog {
  id         String             @id @default(cuid())
  pharmacyId String
  type       NotificationType
  recipient  String
  subject    String?
  message    String
  status     NotificationStatus @default(PENDING)
