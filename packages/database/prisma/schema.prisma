  pharmacyId String
  type       UploadType
  fileName   String
  fileUrl    String
  fileSize   Int
  mimeType   String

  createdAt DateTime @default(now())

  pharmacy       Pharmacy           @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  prescriptions  Prescription[]
  purchaseOrders PurchaseOrder[]
  grns           GoodsReceiptNote[]

  @@index([pharmacyId, type])
  @@map("uploads")
}

enum UploadType {
  PRESCRIPTION
  INVOICE_PDF
  PURCHASE_ORDER_PDF
  GRN_PDF
  LOGO
  REPORT
  PHARMACY_DOCUMENT
}

// ─── Notification Log ────────────────────────────────────────────────────────

model NotificationLog {
  id         String             @id @default(cuid())
  pharmacyId String
  type       NotificationType
  recipient  String
  subject    String?
  message    String
  status     NotificationStatus @default(PENDING)
  error      String?
  sentAt     DateTime?
  isRead     Boolean            @default(false)

  createdAt DateTime @default(now())

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([pharmacyId, createdAt])
  @@index([pharmacyId, status])
  @@index([pharmacyId, isRead])
  // Filtering failed SMS/WhatsApp by type+status
  @@index([pharmacyId, type, status])
  @@map("notification_logs")
}

enum NotificationType {
  SMS
  EMAIL
  WHATSAPP
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ─── Goods Receipt Note ───────────────────────────────────────────────────────
// Created when goods physically arrive. Separate from PO — a PO may have multiple
// GRNs (partial deliveries). Confirming a GRN atomically updates inventory stock
// and writes InventoryMovement records (type = PURCHASE).

model GoodsReceiptNote {
  id                  String    @id @default(cuid())
  pharmacyId          String
  supplierId          String
  purchaseOrderId     String?
  grnNumber           String
  supplierInvoiceNo   String?
  supplierInvoiceDate DateTime?
  status              GRNStatus @default(DRAFT)
  notes               String?
  subtotal            Decimal   @default(0) @db.Decimal(12, 2)
  totalGst            Decimal   @default(0) @db.Decimal(12, 2)
  totalAmount         Decimal   @default(0) @db.Decimal(12, 2)
  confirmedAt         DateTime?
  paymentDueDate      DateTime?
  // Source PDF this GRN was drafted from (e.g. supplier invoice), if any — see Upload model.
  sourceUploadId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy      Pharmacy              @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  supplier      Supplier              @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  sourceUpload  Upload?               @relation(fields: [sourceUploadId], references: [id], onDelete: SetNull)
  items         GRNItem[]
  payments      SupplierLedgerEntry[]

  @@unique([pharmacyId, grnNumber])
  @@index([pharmacyId, status])
  @@index([pharmacyId, supplierId])
  @@index([pharmacyId, paymentDueDate])
  @@index([pharmacyId, createdAt])
  // Covers the actual list-view query shape (WHERE pharmacyId = ? AND status = ?
  // ORDER BY createdAt DESC) used by Gate Inward (DRAFT), Purchase (CONFIRMED),
  // and Overdue Bills — without it, Postgres can use either the (pharmacyId,
  // status) or (pharmacyId, createdAt) index alone but still has to re-sort or
  // over-scan as each status bucket grows.
  @@index([pharmacyId, status, createdAt])
  // Duplicate supplier-invoice detection scoped to pharmacy
  @@index([pharmacyId, supplierInvoiceNo])
  // "All GRNs for this PO" — common join on PO detail page, previously unindexed
  @@index([pharmacyId, purchaseOrderId])
  @@map("goods_receipt_notes")
}

enum SupplierReturnStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum SupplierReturnReason {
  DAMAGED
  NEAR_EXPIRY
  EXPIRED
  WRONG_PRODUCT
  QUALITY_ISSUE
  SHORT_SUPPLY
  OTHER
}

// ─── Supplier Return ──────────────────────────────────────────────────────────
// Raised when pharmacy sends goods back to supplier. Confirming decrements
// inventory and writes InventoryMovement (type=ADJUSTMENT direction=OUT).

model SupplierReturn {
  id            String               @id @default(cuid())
  pharmacyId    String
  supplierId    String
  returnNumber  String
  debitNoteNo   String?
  status        SupplierReturnStatus @default(DRAFT)
  notes         String?
  // GST breakdown — required for a valid debit note under CGST Rule 53.
  // subtotal     = sum(purchaseRate × qty) across all items
  // taxableAmount = subtotal (no discount on supplier returns)
  // cgst / sgst  = half of total GST for intra-state
  // igst         = full GST for inter-state (mutually exclusive with cgst+sgst)
  // totalGst     = cgst + sgst + igst
  // totalAmount  = taxableAmount + totalGst
  subtotal      Decimal              @default(0) @db.Decimal(12, 2)
  taxableAmount Decimal              @default(0) @db.Decimal(12, 2)
  cgst          Decimal              @default(0) @db.Decimal(12, 2)
  sgst          Decimal              @default(0) @db.Decimal(12, 2)
  igst          Decimal              @default(0) @db.Decimal(12, 2)
  totalGst      Decimal              @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal              @default(0) @db.Decimal(12, 2)
  // Line items, denormalized as JSON — same rationale as PurchaseOrder.items
  // above. The confirm() flow's per-item inventory-decrement loop reads this
  // as a plain parsed array; inventoryId per item is re-validated against
  // Inventory at confirm time regardless (it always was, on top of the FK).
  items         Json
  itemCount     Int                  @default(0)

  // When the goods actually went back. GSTR-3B Table 4(B) reverses input credit on this,
  // mirroring Table 4(A)(5), which CLAIMS it on GoodsReceiptNote.confirmedAt. Null until
  // confirmed — which is what lets the 3B query filter on it directly, since a return
  // that was never confirmed has no date on which anything was sent back.
  confirmedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy    Pharmacy              @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  supplier    Supplier              @relation(fields: [supplierId], references: [id])
  creditNotes SupplierLedgerEntry[]

  @@unique([pharmacyId, returnNumber])
  @@index([pharmacyId, status])
  @@index([pharmacyId, supplierId])
  @@map("supplier_returns")
}

// SupplierReturnItem removed — folded into SupplierReturn.items (JSON) above.
// Verified before removal: zero direct table-level queries outside relational
// includes; confirm()'s per-item loop already re-validates inventoryId.

model GRNItem {
  id               String   @id @default(cuid())
  pharmacyId       String
  grnId            String
  medicineId       String
  medicineName     String
  batchNumber      String
  expiryDate       DateTime
  orderedQty       Int?
  receivedQty      Int
  freeQty          Int      @default(0)
  purchaseUnit     String   @default("UNIT") // BOX | STRIP | UNIT
  conversionFactor Int      @default(1) // base units per purchase unit
  purchaseRate     Decimal  @db.Decimal(12, 2)
  mrp              Decimal  @db.Decimal(12, 2)
  discount         Decimal  @default(0) @db.Decimal(12, 2)
  gstRate          Decimal  @db.Decimal(12, 2)
  cgst             Decimal  @db.Decimal(12, 2)
  sgst             Decimal  @db.Decimal(12, 2)
  /// Inter-state purchase tax. Mutually exclusive with cgst/sgst — never both on one line.
  igst             Decimal  @default(0) @db.Decimal(12, 2)
  amount           Decimal  @db.Decimal(12, 2)
  inventoryId      String?

  createdAt DateTime @default(now())

  pharmacy  Pharmacy         @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  grn       GoodsReceiptNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  medicine  Medicine         @relation(fields: [medicineId], references: [id])
  inventory Inventory?       @relation(fields: [inventoryId], references: [id])

  @@index([pharmacyId])
  @@index([grnId])
  @@index([medicineId])
  @@index([inventoryId])
  @@map("grn_items")
}

// ─── Approval Workflow ────────────────────────────────────────────────────────

enum ApprovalStatus {
  NOT_REQUIRED
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// ─── Supplier Ledger Entry ────────────────────────────────────────────────────
// Merges what used to be two tables (SupplierPayment, SupplierCreditNote) into
// one, discriminated by `type` — mirrors the Upload model's UploadType
// discriminator pattern already used elsewhere in this schema. Verified
// before merging: the two were never queried together (no combined ledger
// view exists), so this is a pure internal storage change.
// PAYMENT:     money paid to a supplier, optionally against a specific GRN.
//              Outstanding balance = sum(GRN totalAmounts) - sum(PAYMENT entries).
// CREDIT_NOTE: credit issued by a supplier, usually against a SupplierReturn.

enum SupplierLedgerEntryType {
  PAYMENT
  CREDIT_NOTE
}

model SupplierLedgerEntry {
  id               String                  @id @default(cuid())
  pharmacyId       String
  supplierId       String
  type             SupplierLedgerEntryType
  entryNumber      String // old paymentNumber / creditNoteNumber, namespaced by type below
  amount           Decimal                 @db.Decimal(12, 2)
  // PAYMENT-only fields
  grnId            String?
  paymentMode      PaymentMode?
  paidAt           DateTime?
  // CREDIT_NOTE-only fields
  supplierReturnId String?
  status           CreditNoteStatus?
  issuedAt         DateTime?
  reference        String?
  notes            String?
  createdBy        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy       Pharmacy          @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  supplier       Supplier          @relation(fields: [supplierId], references: [id])
  grn            GoodsReceiptNote? @relation(fields: [grnId], references: [id])
  supplierReturn SupplierReturn?   @relation(fields: [supplierReturnId], references: [id])
  user           User              @relation(fields: [createdBy], references: [id])

  @@unique([pharmacyId, type, entryNumber])
  @@index([pharmacyId, type, supplierId])
  @@index([pharmacyId, type, status])
  @@index([pharmacyId, type, paidAt])
  @@index([pharmacyId, type, issuedAt])
  @@index([grnId])
  @@index([supplierReturnId])
  @@map("supplier_ledger_entries")
}

enum CreditNoteStatus {
  PENDING
  APPLIED
  CANCELLED
}

// ─── Quotation ────────────────────────────────────────────────────────────────
// Request for quotation (RFQ) sent to a supplier; multiple quotations for the
// same items across suppliers allow price comparison before raising a PO.

model Quotation {
  id              String          @id @default(cuid())
  pharmacyId      String
  supplierId      String
  quotationNumber String
  status          QuotationStatus @default(DRAFT)
  validUntil      DateTime?
  notes           String?
  createdBy       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  supplier Supplier        @relation(fields: [supplierId], references: [id])
  items    QuotationItem[]
  user     User            @relation(fields: [createdBy], references: [id])

  @@unique([pharmacyId, quotationNumber])
  @@index([pharmacyId, supplierId])
  @@index([pharmacyId, status])
  @@map("quotations")
}

enum QuotationStatus {
  DRAFT
  SENT
  RECEIVED
  EXPIRED
  CONVERTED
}

model QuotationItem {
  id           String   @id @default(cuid())
  pharmacyId   String
  quotationId  String
  medicineId   String
  medicineName String
  quantity     Int
  quotedRate   Decimal? @db.Decimal(12, 2)
  mrp          Decimal? @db.Decimal(12, 2)
  gstRate      Decimal  @default(12) @db.Decimal(12, 2)
  discount     Decimal  @default(0) @db.Decimal(12, 2)
  notes        String?

  pharmacy  Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  medicine  Medicine  @relation(fields: [medicineId], references: [id])

  @@index([pharmacyId])
  @@index([quotationId])
  @@map("quotation_items")
}

// ─── Rack & Shelf Location Management ────────────────────────────────────────

model Rack {
  id         String  @id @default(cuid())
  pharmacyId String
  code       String // e.g. R1, R2 — unique per pharmacy
  name       String // e.g. "Cold Storage", "Antibiotics Aisle"
  aisle      String?
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  shelves  Shelf[]

  @@unique([pharmacyId, code])
  @@index([pharmacyId])
  @@map("racks")
}

model Shelf {
  id          String  @id @default(cuid())
  pharmacyId  String
  rackId      String
  code        String // e.g. A1, A2, B3 — unique per pharmacy
  level       Int // 1 = bottom shelf, ascending = higher
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy  Pharmacy    @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  rack      Rack        @relation(fields: [rackId], references: [id])
  inventory Inventory[]

  @@unique([pharmacyId, code])
  @@index([pharmacyId, rackId])
  @@map("shelves")
}

// ─── Physical Stock Audit ─────────────────────────────────────────────────────
// A session snapshots current inventory quantities. Staff enter actual counts.
// Approving the session applies variances as ADJUSTMENT movements.

model StockAuditSession {
  id            String             @id @default(cuid())
  pharmacyId    String
  sessionNumber String // e.g. AUDIT-20250603-001
  status        AuditSessionStatus @default(DRAFT)
  notes         String?
  startedAt     DateTime?
  completedAt   DateTime?
  approvedAt    DateTime?
  approvedBy    String?
  createdBy     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy Pharmacy         @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  approver User?            @relation("StockAuditApprover", fields: [approvedBy], references: [id])
  creator  User             @relation("StockAuditCreator", fields: [createdBy], references: [id])
  items    StockAuditItem[]

  @@unique([pharmacyId, sessionNumber])
  @@index([pharmacyId, status])
  @@map("stock_audit_sessions")
}

model StockAuditItem {
  id          String  @id @default(cuid())
  pharmacyId  String
  sessionId   String
  inventoryId String
  expectedQty Int // snapshot of inventory.quantity at session creation
  countedQty  Int? // staff enters this during count
  varianceQty Int? // computed: countedQty - expectedQty
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy  Pharmacy          @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  session   StockAuditSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  inventory Inventory         @relation(fields: [inventoryId], references: [id])

  @@unique([sessionId, inventoryId])
  @@index([pharmacyId])
  @@index([sessionId])
  @@index([inventoryId])
  @@index([sessionId, countedQty]) // completeSession uncounted check + listSessions enrichment
  @@index([sessionId, varianceQty]) // listSessions variance count
  @@map("stock_audit_items")
}

enum AuditSessionStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  APPROVED
  CANCELLED
}

// ─── Batch Recall ─────────────────────────────────────────────────────────────
// Regulatory record for every recall action. Previously stored as a text probe
// on InventoryMovement (notes STARTSWITH "RECALL:"), which is fragile and
// unauditable. This dedicated table is the authoritative source of truth.
//
// The affected inventory rows are quarantined (status = QUARANTINE) and one
// InventoryMovement row is written per item with referenceType = "BATCH_RECALL"
// and referenceId = BatchRecall.id — maintaining the ledger link while
// ensuring the recall audit trail has first-class representation.

model BatchRecall {
  id          String   @id @default(cuid())
  pharmacyId  String
  batchNumber String
  medicineId  String?
  reason      String
  recalledBy  String
  recalledAt  DateTime @default(now())
  affectedIds String[] // snapshot of inventory IDs quarantined by this recall

  pharmacy Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicine Medicine? @relation(fields: [medicineId], references: [id])
  user     User      @relation("BatchRecallUser", fields: [recalledBy], references: [id])

  @@index([pharmacyId, batchNumber])
  @@index([pharmacyId, recalledAt(sort: Desc)])
  @@index([pharmacyId, medicineId])
  @@map("batch_recalls")
}

// ─── Support Module ───────────────────────────────────────────────────────────

model TicketSequence {
  id      String @id
  current Int    @default(1)

  @@map("ticket_sequences")
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  PENDING_USER
  RESOLVED
  CLOSED
}

enum TicketLanguage {
  HINDI
  ENGLISH
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketSLA {
  SLA_4H
  SLA_8H
  SLA_24H
  SLA_48H
  SLA_72H
  SLA_3D
}

enum AttachmentFileType {
  IMAGE
  VIDEO
  DOCUMENT
}

model TicketCategory {
  id        String  @id @default(cuid())
  name      String  @unique
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  tickets SupportTicket[]

  @@map("ticket_categories")
}

model SupportAgent {
  id             String    @id @default(cuid())
  userId         String    @unique
  isActive       Boolean   @default(true)
  lastAssignedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id])
  tickets SupportTicket[]

  @@map("support_agents")
}

model SupportTicket {
  id              String         @id @default(cuid())
  ticketNumber    String         @unique
  pharmacyId      String
  raisedById      String
  categoryId      String
  customTitle     String?
  assignedAgentId String?
  status          TicketStatus   @default(OPEN)
  priority        TicketPriority @default(MEDIUM)
  sla             TicketSLA?
  language        TicketLanguage @default(ENGLISH)
  dueDate         DateTime?
  description     String
  mobile          String
  altMobile       String?
  resolvedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy      Pharmacy           @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  raisedBy      User               @relation("TicketRaisedBy", fields: [raisedById], references: [id])
  assignedAgent SupportAgent?      @relation(fields: [assignedAgentId], references: [id])
  category      TicketCategory     @relation(fields: [categoryId], references: [id])
  messages      TicketMessage[]
  attachments   TicketAttachment[]

  @@index([pharmacyId, status])
  @@index([pharmacyId, createdAt(sort: Desc)])
  @@index([assignedAgentId, status])
  @@index([raisedById])
  @@index([priority])
  @@map("support_tickets")
}

model TicketMessage {
  id         String @id @default(cuid())
  pharmacyId String
  ticketId   String
  senderId   String
  message    String

  createdAt DateTime @default(now())

  pharmacy    Pharmacy           @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  ticket      SupportTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender      User               @relation("TicketMessageSender", fields: [senderId], references: [id])
  attachments TicketAttachment[]

  @@index([pharmacyId])
  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

model TicketAttachment {
  id         String             @id @default(cuid())
  pharmacyId String
  ticketId   String
  messageId  String?
  fileName   String
  fileUrl    String
  fileSize   Int
  mimeType   String
  fileType   AttachmentFileType

  createdAt DateTime @default(now())

  pharmacy Pharmacy       @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  ticket   SupportTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message  TicketMessage? @relation(fields: [messageId], references: [id])

  @@index([pharmacyId])
  @@index([ticketId])
  @@map("ticket_attachments")
}

