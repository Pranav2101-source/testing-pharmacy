generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Pharmacy (one per registered pharmacy) ──────────────────────────────────

model Pharmacy {
  id            String  @id @default(cuid())
  name          String
  slug          String  @unique
  gstin         String?
  drugLicense   String?
  phone         String?
  email         String?
  address       String?
  city          String?
  state         String?
  pincode       String?
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  customers           Customer[]
  suppliers           Supplier[]
  inventory           Inventory[]
  purchaseOrders      PurchaseOrder[]
  invoices            Invoice[]
  invoiceSettings     InvoiceSettings?
  auditLogs           AuditLog[]
  uploads             Upload[]
  notifications       NotificationLog[]
  invoicePayments     InvoicePayment[]
  salesReturns        SalesReturn[]
  inventoryMovements  InventoryMovement[]
  stockReservations   StockReservation[]
  grns                GoodsReceiptNote[]
  supplierReturns     SupplierReturn[]
  supplierPayments    SupplierPayment[]
  supplierCreditNotes SupplierCreditNote[]
  quotations          Quotation[]
  racks               Rack[]
  shelves             Shelf[]
  stockAuditSessions  StockAuditSession[]
  calendarEvents      CalendarEvent[]
  supportTickets      SupportTicket[]
  documentSequences   DocumentSequence[]
  medicineOverrides   PharmacyMedicineOverride[]
  doctors             Doctor[]
  cashClosures        CashClosure[]
  // Child-table back-relations (added for RLS + tenant isolation on item rows)
  invoiceItems        InvoiceItem[]
  grnItems            GRNItem[]
  purchaseOrderItems  PurchaseOrderItem[]
  salesReturnItems    SalesReturnItem[]
  supplierReturnItems SupplierReturnItem[]
  quotationItems      QuotationItem[]
  stockAuditItems     StockAuditItem[]
  ticketMessages      TicketMessage[]
  ticketAttachments   TicketAttachment[]
  prescriptions       Prescription[]
  prescriptionItems   PrescriptionItem[]
  batchRecalls        BatchRecall[]

  @@map("pharmacies")
}

// ─── Document Sequence ────────────────────────────────────────────────────────
// Transactional per-pharmacy counters for all document numbers (invoices,
// returns, POs, GRNs, supplier returns, quotations, stock audits). Replaces
// Redis INCR, which loses its value on a Redis restart/eviction and then
// produces numbers that collide with the unique (pharmacyId, number)
// constraints. `period` scopes each counter to an Indian financial year
// ("2025-2026") — or a single IST day ("20250612") for stock audits — so
// numbering restarts automatically per GST rules.
//
// Increment with one atomic upsert (used inside the billing transaction, which
// also makes invoice numbering GAPLESS — a rolled-back sale returns its number):
//   INSERT ... VALUES (pharmacyId, kind, period, 1)
//   ON CONFLICT DO UPDATE SET value = value + 1 RETURNING value

model DocumentSequence {
  pharmacyId String
  kind       String // INVOICE | SALES_RETURN | PURCHASE_ORDER | GRN | SUPPLIER_RETURN | QUOTATION | STOCK_AUDIT
  period     String // "2025-2026" (financial year) or "20250612" (IST day, audits)
  value      Int      @default(0)
  updatedAt  DateTime @updatedAt

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@id([pharmacyId, kind, period])
  @@map("document_sequences")
}

// ─── User (Staff) ────────────────────────────────────────────────────────────

model User {
  id                          String    @id @default(cuid())
  pharmacyId                  String
  name                        String
  email                       String
  phone                       String?
  passwordHash                String
  role                        Role      @default(PHARMACIST)
  isActive                    Boolean   @default(true)
  lastLoginAt                 DateTime?
  // Refresh token rotation: increment on every /refresh or logout to invalidate all older tokens
  tokenVersion                Int       @default(0)
  // Password reset (store hashed token; send plaintext to user via email)
  passwordResetToken          String?   @unique
  passwordResetTokenExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy            Pharmacy             @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  invoices            Invoice[]
  auditLogs           AuditLog[]
  invoicePayments     InvoicePayment[]
  salesReturns        SalesReturn[]
  inventoryMovements  InventoryMovement[]
  supplierPayments    SupplierPayment[]
  supplierCreditNotes SupplierCreditNote[]
  quotations          Quotation[]
  calendarEvents      CalendarEvent[]      @relation("CalendarEventCreator")
  ticketsRaised       SupportTicket[]      @relation("TicketRaisedBy")
  ticketMessages      TicketMessage[]      @relation("TicketMessageSender")
  supportAgent          SupportAgent?
  cashClosures          CashClosure[]
  approvedAuditSessions StockAuditSession[] @relation("StockAuditApprover")
  createdAuditSessions  StockAuditSession[] @relation("StockAuditCreator")
  approvedPOs           PurchaseOrder[]     @relation("POApprover")
  batchRecalls          BatchRecall[]       @relation("BatchRecallUser")

  @@unique([pharmacyId, email])
  @@index([pharmacyId, role])
  @@map("users")
}

enum Role {
  OWNER
  MANAGER
  PHARMACIST
  CASHIER
  SUPPORT_AGENT
  PLATFORM_ADMIN
}

// ─── Medicine (Global — shared across all pharmacies) ────────────────────────

model Medicine {
  id           String  @id @default(cuid())
  name         String
  genericName  String?
  manufacturer String?
  composition  String?
  // category (free text) is kept for backward compat with existing data/API.
  // categoryId (FK) is the structured replacement — use it for new features.
  // When both are set, categoryId wins for filtering; category is the display fallback.
  category     String?
  categoryId   String?
  schedule     String? // OTC, H, X, G
  hsnCode      String?
  gstRate      Decimal @default(12) @db.Decimal(12, 2)
  form         String? // tablet, syrup, injection, cream
  strength     String? // 500mg, 5ml
  unit         String? // strip, bottle, vial, tube
  packSize     String? // 10 tablets, 100ml
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brandId    String?
  brand      Brand?           @relation(fields: [brandId], references: [id])
  productCategory ProductCategory? @relation(fields: [categoryId], references: [id])
  barcode    String?
  boxSize    Int?        // strips per box; used with packSize for unit conversion
  catalogMrp Decimal?    @db.Decimal(12, 2) // reference price — pre-fills GRN form only, never used for billing

  inventory           Inventory[]
  grnItems            GRNItem[]
  supplierReturnItems SupplierReturnItem[]
  quotationItems      QuotationItem[]
  purchaseOrderItems  PurchaseOrderItem[]
  pharmacyOverrides   PharmacyMedicineOverride[]
  prescriptionItems   PrescriptionItem[]
  batchRecalls        BatchRecall[]

  @@index([name])
  @@index([genericName])
  @@index([hsnCode])
  @@index([category])
  @@index([categoryId])
  @@index([barcode])
  @@index([manufacturer])
  @@index([isActive])
  @@map("medicines")
}

// ─── Per-pharmacy medicine override ──────────────────────────────────────────
// The medicine catalog is GLOBAL and only PLATFORM_ADMIN can mutate it. When a
// single pharmacy needs a different GST rate (e.g. a state-specific ruling or
// a catalog error they cannot wait on) or a standing discount for a medicine,
// the owner records an override here instead of editing the shared record.
// NULL field = "use the catalog value". Applied at billing checkout (the
// authoritative GST computation) and overlaid on pharmacy-scoped inventory
// reads; the global search cache stays untouched.

model PharmacyMedicineOverride {
  pharmacyId         String
  medicineId         String
  gstRate            Decimal? @db.Decimal(12, 2) // null = catalog gstRate
  defaultDiscountPct Decimal? @db.Decimal(12, 2) // standing % discount pre-filled at POS
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@id([pharmacyId, medicineId])
  @@map("pharmacy_medicine_overrides")
}

// ─── Brand (global — shared across all pharmacies) ───────────────────────────

model Brand {
  id           String     @id @default(cuid())
  name         String     @unique
  manufacturer String?
  country      String?
  isActive     Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medicines Medicine[]

  @@index([name])
  @@map("brands")
}

// ─── Product Category (global) ───────────────────────────────────────────────

model ProductCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  code        String?
  description String?
  parentId    String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent    ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  ProductCategory[] @relation("CategoryHierarchy")
  medicines Medicine[]

  @@index([name])
  @@map("product_categories")
}

// ─── Inventory (per pharmacy, per batch) ─────────────────────────────────────

model Inventory {
  id               String      @id @default(cuid())
  pharmacyId       String
  medicineId       String
  batchNumber      String
  expiryDate       DateTime
  quantity         Int
  reservedQuantity Int         @default(0)
  purchaseRate     Decimal     @db.Decimal(12, 2)
  mrp              Decimal     @db.Decimal(12, 2)
  location         String?
  shelfId          String?
  minimumStock     Int         @default(10)
  reorderLevel     Int         @default(5)
  status           BatchStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy            Pharmacy            @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicine            Medicine            @relation(fields: [medicineId], references: [id])
  shelf               Shelf?              @relation(fields: [shelfId], references: [id])
  invoiceItems        InvoiceItem[]
  salesReturnItems    SalesReturnItem[]
  inventoryMovements  InventoryMovement[]
  stockReservations   StockReservation[]
  grnItems            GRNItem[]
  supplierReturnItems SupplierReturnItem[]
  stockAuditItems     StockAuditItem[]

  @@unique([pharmacyId, medicineId, batchNumber])
  @@index([pharmacyId, medicineId])
  @@index([pharmacyId, expiryDate])
  @@index([pharmacyId, status])
  // Covering index for active-stock and low-stock queries: WHERE pharmacyId=? AND status='ACTIVE' AND quantity>0
  @@index([pharmacyId, status, quantity])
  // Covering index for FEFO batch selection: WHERE pharmacyId=? AND medicineId=? AND status='ACTIVE' ORDER BY expiryDate ASC
  @@index([pharmacyId, medicineId, status, expiryDate])
  @@map("inventory")
}

// ─── Stock Reservation ───────────────────────────────────────────────────────
// Created when a billing session adds an item to cart; released when bill is
// saved, cleared, or the TTL expires. Prevents two operators from selling the
// same last strip simultaneously.

model StockReservation {
  id          String   @id @default(cuid())
  pharmacyId  String
  inventoryId String
  sessionId   String   // idempotency key of the billing session
  quantity    Int
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  pharmacy  Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([pharmacyId, inventoryId, sessionId])
  @@index([pharmacyId, sessionId])
  @@index([expiresAt])
  @@map("stock_reservations")
}

// ─── Customer ────────────────────────────────────────────────────────────────

model Customer {
  id              String       @id @default(cuid())
  pharmacyId      String
  name            String
  phone           String?
  email           String?
  address         String?
  state           String?      // Indian state code (e.g. "MH", "KA") — used for IGST determination
  dateOfBirth     DateTime?
  gender          String?
  abhaNumber      String?      // ABHA / Health ID / IPD / OPD number
  cardNumber      String?      // Pharmacy loyalty card (unique per pharmacy; NULLs are distinct)
  customerType    CustomerType @default(WALK_IN)
  defaultDiscount Decimal      @default(0) @db.Decimal(12, 2) // auto-applied discount % shown at billing
  creditLimit     Decimal      @default(0) @db.Decimal(12, 2)
  creditUsed      Decimal      @default(0) @db.Decimal(12, 2)
  notes           String?
  deletedAt       DateTime?    // soft delete — null = active
  createdById     String?      // ID of staff who created (stored as plain ID; preserved on user delete)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy    Pharmacy      @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  invoices    Invoice[]
  returns     SalesReturn[]

  @@unique([pharmacyId, cardNumber])
  @@index([pharmacyId, phone])
  @@index([pharmacyId, name])
  @@index([pharmacyId, abhaNumber])
  @@index([pharmacyId, customerType])
  @@index([pharmacyId, deletedAt])
  @@index([pharmacyId, email])
  @@map("customers")
}

enum CustomerType {
  WALK_IN
  REGISTERED
  CORPORATE
  CREDIT
}

// ─── Supplier ────────────────────────────────────────────────────────────────

model Supplier {
  id           String  @id @default(cuid())
  pharmacyId   String
  name         String
  gstin        String?
  dlNumber     String?
  phone        String?
  email        String?
  address      String?
  city         String?
  state        String?
  creditLimit   Decimal @default(0) @db.Decimal(12, 2)
  creditDays    Int     @default(30)
  paymentTerms  String?
  isActive      Boolean @default(true)
  // Running balance: incremented on GRN confirm, decremented on payment or supplier return.
  // Positive = pharmacy owes supplier; negative = supplier owes pharmacy (over-payment or credit).
  // Avoids two aggregate queries on every supplier list / balance badge read.
  ledgerBalance Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy        Pharmacy             @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  purchaseOrders  PurchaseOrder[]
  grns            GoodsReceiptNote[]
  supplierReturns SupplierReturn[]
  payments        SupplierPayment[]
  creditNotes     SupplierCreditNote[]
  quotations      Quotation[]

  @@index([pharmacyId])
  @@index([pharmacyId, isActive])
  @@map("suppliers")
}

// ─── Purchase Order ───────────────────────────────────────────────────────────

model PurchaseOrder {
  id              String         @id @default(cuid())
  pharmacyId      String
  supplierId      String
  orderNumber     String
  invoiceNo       String?
  status          PurchaseStatus @default(DRAFT)
  approvalStatus  ApprovalStatus @default(NOT_REQUIRED)
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  subtotal        Decimal        @default(0) @db.Decimal(12, 2)
  totalGst        Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal        @default(0) @db.Decimal(12, 2)
  notes           String?
  expectedDate    DateTime?
  orderedAt       DateTime       @default(now())
  receivedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy Pharmacy            @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  approver User?               @relation("POApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  items    PurchaseOrderItem[]
  grns     GoodsReceiptNote[]

  @@unique([pharmacyId, orderNumber])
  @@index([pharmacyId, status])
  @@index([pharmacyId, supplierId])
  @@index([pharmacyId, approvalStatus])
  @@map("purchase_orders")
}

enum PurchaseStatus {
  DRAFT
  PENDING
  RECEIVED
  PARTIAL
  CANCELLED
}

enum BatchStatus {
  ACTIVE
  QUARANTINE
  EXPIRED
  DAMAGED
}

enum GRNStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model PurchaseOrderItem {
  id              String   @id @default(cuid())
  pharmacyId      String
  purchaseOrderId String
  medicineId      String
  medicineName    String
  batchNumber     String
  expiryDate      DateTime
  quantity        Int
  purchaseRate    Decimal  @db.Decimal(12, 2)
  mrp             Decimal  @db.Decimal(12, 2)
  gstRate         Decimal  @db.Decimal(12, 2)
  cgst            Decimal  @db.Decimal(12, 2)
  sgst            Decimal  @db.Decimal(12, 2)
  amount          Decimal  @db.Decimal(12, 2)

  pharmacy      Pharmacy      @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  medicine      Medicine      @relation(fields: [medicineId], references: [id])

  @@index([pharmacyId])
  @@index([purchaseOrderId])
  @@index([medicineId])
  // Medicine-wise purchase history (how much did we pay for X over last N months)
  @@index([pharmacyId, medicineId])
  @@map("purchase_order_items")
}

// ─── Invoice ─────────────────────────────────────────────────────────────────

model Invoice {
  id              String        @id @default(cuid())
  pharmacyId      String
  invoiceNumber   String
  customerId      String?
  // Snapshot of customer name/phone at billing time — avoids JOIN in search queries
  // and preserves the name even if the customer record is later updated.
  customerName    String?
  customerPhone   String?
  userId          String
  doctorId        String?
  doctorName      String?
  // Snapshot doctor registration number at billing time so the audit trail
  // is self-contained even if the doctor record is later edited or deleted.
  doctorRegNo     String?
  prescriptionId  String?
  paymentMode     PaymentMode   @default(CASH)
  paymentStatus   PaymentStatus @default(PAID)
  status          InvoiceStatus @default(COMPLETED)
  subtotal        Decimal       @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(12, 2)
  taxableAmount   Decimal       @db.Decimal(12, 2)
  cgst            Decimal       @db.Decimal(12, 2)
  sgst            Decimal       @db.Decimal(12, 2)
  igst            Decimal       @default(0) @db.Decimal(12, 2)
  totalGst        Decimal       @db.Decimal(12, 2)
  totalAmount     Decimal       @db.Decimal(12, 2)
  returnedAmount  Decimal       @default(0) @db.Decimal(12, 2)
  isInterstate    Boolean       @default(false)
  notes           String?
  isCancelled     Boolean       @default(false)
  cancelledAt     DateTime?
  cancelReason    String?
  idempotencyKey  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy     Pharmacy         @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  customer     Customer?        @relation(fields: [customerId], references: [id])
  doctor       Doctor?          @relation(fields: [doctorId], references: [id])
  user         User             @relation(fields: [userId], references: [id])
  prescription Prescription?    @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  items        InvoiceItem[]
  payments     InvoicePayment[]
  returns      SalesReturn[]

  @@unique([pharmacyId, invoiceNumber])
  @@unique([pharmacyId, idempotencyKey])
  @@index([pharmacyId, createdAt])
  @@index([pharmacyId, customerId])
  @@index([pharmacyId, status])
  // Covering index for pending-credit queries: WHERE pharmacyId=? AND paymentStatus='PENDING' AND isCancelled=false
  @@index([pharmacyId, paymentStatus, isCancelled])
  // Covering index for filtered invoice list sorted by date (most common view)
  @@index([pharmacyId, isCancelled, createdAt(sort: Desc)])
  // Doctor-wise prescription report (full scan without this)
  @@index([pharmacyId, doctorId])
  // Cashier-wise billing report
  @@index([pharmacyId, userId])
  @@map("invoices")
}

// ─── Prescription ─────────────────────────────────────────────────────────────
// Structured prescription record linking a scanned upload to doctor + patient
// details and the list of drugs prescribed. Required for Schedule H / H1 / X
// drugs under the Drugs & Cosmetics Act before dispensing.

model Prescription {
  id                 String             @id @default(cuid())
  pharmacyId         String
  prescriptionNumber String
  doctorId           String?
  doctorName         String
  doctorRegNo        String?            // MCI / state council registration number
  doctorPhone        String?
  patientName        String
  patientAge         Int?
  patientPhone       String?
  patientGender      String?
  uploadId           String?            // scanned prescription image
  prescribedDate     DateTime?
  validUntil         DateTime?
  status             PrescriptionStatus @default(ACTIVE)
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy Pharmacy          @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  doctor   Doctor?           @relation(fields: [doctorId], references: [id])
  upload   Upload?           @relation(fields: [uploadId], references: [id])
  invoices Invoice[]
  items    PrescriptionItem[]

  @@unique([pharmacyId, prescriptionNumber])
  @@index([pharmacyId, status])
  @@index([pharmacyId, doctorId])
  @@index([pharmacyId, createdAt])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String  @id @default(cuid())
  pharmacyId     String
  prescriptionId String
  medicineName   String
  medicineId     String?
  schedule       String? // H, H1, X, G, OTC
  quantity       Int
  dispensedQty   Int     @default(0)
  dosage         String?
  duration       String?
  notes          String?

  createdAt DateTime @default(now())

  pharmacy     Pharmacy     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine     Medicine?    @relation(fields: [medicineId], references: [id])

  @@index([pharmacyId])
  @@index([prescriptionId])
  @@map("prescription_items")
}

enum PrescriptionStatus {
  ACTIVE
  PARTIAL
  DISPENSED
  EXPIRED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  COMPLETED
  CANCELLED
  RETURNED
  PARTIALLY_RETURNED
}

enum PaymentMode {
  CASH
  UPI
  CARD
  CREDIT
  WALLET
}

enum PaymentStatus {
  PAID
  PENDING
  PARTIAL
}

model InvoiceItem {
  id            String   @id @default(cuid())
  pharmacyId    String
  invoiceId     String
  inventoryId   String
  medicineName  String
  hsnCode       String?
  batchNumber   String
  expiryDate    DateTime
  quantity      Int
  mrp           Decimal  @db.Decimal(12, 2)
  rate          Decimal  @db.Decimal(12, 2)
  purchaseRate  Decimal  @default(0) @db.Decimal(12, 2)
  discount      Decimal  @default(0) @db.Decimal(12, 2)
  gstRate       Decimal  @db.Decimal(12, 2)
  cgst          Decimal  @db.Decimal(12, 2)
  sgst          Decimal  @db.Decimal(12, 2)
  igst          Decimal  @default(0) @db.Decimal(12, 2)
  taxableAmount Decimal  @db.Decimal(12, 2)
  amount        Decimal  @db.Decimal(12, 2)

  pharmacy         Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  invoice          Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  inventory        Inventory       @relation(fields: [inventoryId], references: [id])
  salesReturnItems SalesReturnItem[]

  @@index([pharmacyId])
  @@index([invoiceId])
  @@index([inventoryId])
  @@map("invoice_items")
}

// ─── Invoice Payments (split payment support) ────────────────────────────────

model InvoicePayment {
  id          String      @id @default(cuid())
  pharmacyId  String
  invoiceId   String
  amount      Decimal     @db.Decimal(12, 2)
  paymentMode PaymentMode
  reference   String?
  notes       String?
  paidAt      DateTime    @default(now())
  createdBy   String

  pharmacy      Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdByUser User     @relation(fields: [createdBy], references: [id])

  @@index([invoiceId])
  @@index([pharmacyId, paidAt])
  @@map("invoice_payments")
}

// ─── Sales Return ─────────────────────────────────────────────────────────────

model SalesReturn {
  id             String   @id @default(cuid())
  pharmacyId     String
  invoiceId      String
  returnNumber   String
  reason         String?
  userId         String
  customerId     String?
  subtotal       Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  taxableAmount  Decimal  @db.Decimal(12, 2)
  cgst           Decimal  @db.Decimal(12, 2)
  sgst           Decimal  @db.Decimal(12, 2)
  igst           Decimal  @default(0) @db.Decimal(12, 2)
  totalGst       Decimal  @db.Decimal(12, 2)
  totalAmount    Decimal  @db.Decimal(12, 2)
  idempotencyKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy Pharmacy          @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  invoice  Invoice           @relation(fields: [invoiceId], references: [id])
  user     User              @relation(fields: [userId], references: [id])
  customer Customer?         @relation(fields: [customerId], references: [id])
  items    SalesReturnItem[]

  @@unique([pharmacyId, returnNumber])
  @@unique([pharmacyId, idempotencyKey])
  @@index([pharmacyId, invoiceId])
  @@index([pharmacyId, createdAt])
  @@map("sales_returns")
}

enum ReturnDisposition {
  RESTOCK
  WRITEOFF
}

model SalesReturnItem {
  id            String            @id @default(cuid())
  pharmacyId    String
  returnId      String
  invoiceItemId String?
  inventoryId   String
  medicineName  String
  hsnCode       String?
  batchNumber   String
  expiryDate    DateTime
  quantity      Int
  mrp           Decimal           @db.Decimal(12, 2)
  rate          Decimal           @db.Decimal(12, 2)
  discount      Decimal           @default(0) @db.Decimal(12, 2)
  gstRate       Decimal           @db.Decimal(12, 2)
  cgst          Decimal           @db.Decimal(12, 2)
  sgst          Decimal           @db.Decimal(12, 2)
  igst          Decimal           @default(0) @db.Decimal(12, 2)
  taxableAmount Decimal           @db.Decimal(12, 2)
  amount        Decimal           @db.Decimal(12, 2)
  disposition   ReturnDisposition @default(RESTOCK)

  pharmacy    Pharmacy     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  return      SalesReturn  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  inventory   Inventory    @relation(fields: [inventoryId], references: [id])
  invoiceItem InvoiceItem? @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)

  @@index([pharmacyId])
  @@index([returnId])
  @@index([inventoryId])
  @@index([invoiceItemId])
  @@map("sales_return_items")
}

// ─── Inventory Movement (full stock ledger) ───────────────────────────────────
// Append-only. Every stock change writes one record here for full reconciliation.

model InventoryMovement {
  id              String             @id @default(cuid())
  pharmacyId      String
  inventoryId     String
  userId          String
  type            MovementType
  direction       MovementDirection
  quantity        Int
  quantityBefore  Int
  quantityAfter   Int
  // Valid values (enforced by DB CHECK): GRN | INVOICE | INVOICE_CANCEL | SALES_RETURN |
  // SUPPLIER_RETURN | BATCH_RECALL | STATUS_CHANGE | STOCK_AUDIT |
  // CORRECTION | DAMAGE | EXPIRY_WRITEOFF | OPENING_BALANCE | TRANSFER | THEFT | BREAKAGE | STOCK_COUNT | OTHER
  referenceType   String?
  referenceId     String?
  notes           String?

  createdAt DateTime @default(now())

  pharmacy  Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  inventory Inventory @relation(fields: [inventoryId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([pharmacyId, inventoryId])
  @@index([pharmacyId, createdAt])
  @@index([referenceId])
  // Covering index for ledger filtered by movement type (sale/purchase/adjustment history views)
  @@index([pharmacyId, type, createdAt(sort: Desc)])
  // User-wise stock movement audit
  @@index([pharmacyId, userId, createdAt(sort: Desc)])
  @@map("inventory_movements")
}

enum MovementType {
  SALE
  RETURN
  PURCHASE
  ADJUSTMENT
  OPENING
  DAMAGE
  EXPIRY_REMOVAL
}

enum MovementDirection {
  IN
  OUT
}

