generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Tenant Status (Platform Admin lifecycle) ────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
  PENDING
  TRIAL
  EXPIRED
}

// ─── Pharmacy (one per registered pharmacy) ──────────────────────────────────

model Pharmacy {
  id              String       @id @default(cuid())
  tenantCode      String?      @unique // e.g. TEN-000001 — generated on create
  name            String
  slug            String       @unique
  gstin           String?
  drugLicense     String?
  phone           String?
  email           String?
  address         String?
  city            String?
  state           String?
  pincode         String?
  isActive        Boolean      @default(true)
  tenantStatus    TenantStatus @default(ACTIVE)
  logoUrl         String? // Supabase storage path; signed on read
  documents       Json? // StoredDoc[] — compliance doc metadata (number, expiry, file path)
  // Per-pharmacy invoice/GST/numbering config (1:1, was the InvoiceSettings table).
  // Inlined as a column — it was a strict 1:1 holding a single JSON blob, only ever
  // read by pharmacyId and written via upsert, so a separate table bought nothing.
  invoiceSettings Json?
  // Billing-screen action config: which save actions exist, which are pinned to the
  // Save dropdown, and their order. Pharmacy-level rather than per-user — deciding
  // "we don't do home delivery" is a shop policy, not a cashier's preference, and it
  // must look the same on every till. Same shape and lifecycle as invoiceSettings.
  billingPreferences Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  customers             Customer[]
  suppliers             Supplier[]
  inventory             Inventory[]
  purchaseOrders        PurchaseOrder[]
  invoices              Invoice[]
  auditLogs             AuditLog[]
  uploads               Upload[]
  notifications         NotificationLog[]
  invoicePayments       InvoicePayment[]
  salesReturns          SalesReturn[]
  inventoryMovements    InventoryMovement[]
  stockReservations     StockReservation[]
  grns                  GoodsReceiptNote[]
  supplierReturns       SupplierReturn[]
  supplierLedgerEntries SupplierLedgerEntry[]
  quotations            Quotation[]
  racks                 Rack[]
  shelves               Shelf[]
  stockAuditSessions    StockAuditSession[]
  calendarEvents        CalendarEvent[]
  supportTickets        SupportTicket[]
  documentSequences     DocumentSequence[]
  medicineOverrides     PharmacyMedicineOverride[]
  doctors               Doctor[]
  cashClosures          CashClosure[]
  subscription          Subscription?
  tenantSettings        TenantSettings?
  // Child-table back-relations (added for RLS + tenant isolation on item rows)
  invoiceItems          InvoiceItem[]
  grnItems              GRNItem[]
  salesReturnItems      SalesReturnItem[]
  quotationItems        QuotationItem[]
  stockAuditItems       StockAuditItem[]
  ticketMessages        TicketMessage[]
  ticketAttachments     TicketAttachment[]
  prescriptions         Prescription[]
  prescriptionItems     PrescriptionItem[]
  batchRecalls          BatchRecall[]
  migrationSessions     MigrationSession[]
  migrationImportJobs   MigrationImportJob[]
  medicineMappings      MedicineMapping[]

  @@map("pharmacies")
}

// ─── Subscription (one per pharmacy, platform-managed) ────────────────────────

model Subscription {
  id            String             @id @default(cuid())
  pharmacyId    String             @unique
  planName      String             @default("Free") // Free | Standard | Professional | Enterprise
  status        SubscriptionStatus @default(ACTIVE)
  billingCycle  String             @default("MONTHLY") // MONTHLY | YEARLY | QUARTERLY
  amount        Float? // price for current plan cycle
  autoRenew     Boolean            @default(true)
  validUntil    DateTime
  trialEndsAt   DateTime?
  pausedAt      DateTime?
  cancelledAt   DateTime?
  discount      Float              @default(0) // percentage
  couponCode    String?
  creditBalance Float              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy  Pharmacy               @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  invoices  SubscriptionInvoice[]
  auditLogs SubscriptionAuditLog[]

  @@index([status])
  @@index([validUntil])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  PAUSED
  EXPIRED
  CANCELLED
}

// ─── Subscription Invoice ─────────────────────────────────────────────────────

model SubscriptionInvoice {
  id             String               @id @default(cuid())
  subscriptionId String
  pharmacyId     String
  invoiceNumber  String               @unique
  amount         Float
  tax            Float                @default(0)
  discount       Float                @default(0)
  total          Float
  couponCode     String?
  status         InvoicePaymentStatus @default(PENDING)
  dueDate        DateTime
  paidAt         DateTime?
  gstinPharmacy  String?
  gstinPlatform  String?

  createdAt DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([pharmacyId])
  @@map("subscription_invoices")
}

enum InvoicePaymentStatus {
  PAID
  PENDING
  OVERDUE
  CANCELLED
  REFUNDED
}

// ─── Subscription Audit Log ───────────────────────────────────────────────────

model SubscriptionAuditLog {
  id             String  @id @default(cuid())
  subscriptionId String
  action         String // PLAN_CHANGED, RENEWED, PAUSED, RESUMED, CANCELLED, INVOICE_GENERATED, REMINDER_SENT
  oldValue       String? // JSON
  newValue       String? // JSON
  performedBy    String // user id

  createdAt DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("subscription_audit_logs")
}

// ─── Tenant Settings (feature flags & limits per pharmacy) ────────────────────

model TenantSettings {
  id                  String  @id @default(cuid())
  pharmacyId          String  @unique
  doctorLimit         Int     @default(5)
  staffLimit          Int     @default(5)
  patientLimit        Int     @default(500)
  storageLimit        Int     @default(1024) // in MB
  enableBilling       Boolean @default(true)
  enableInventory     Boolean @default(true)
  enableEmr           Boolean @default(false)
  enableCrm           Boolean @default(false)
  enableWhatsapp      Boolean @default(false)
  enableSms           Boolean @default(false)
  enableApiAccess     Boolean @default(false)
  enableOnlineBooking Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

// ─── Document Sequence ────────────────────────────────────────────────────────
// Transactional per-pharmacy counters for all document numbers (invoices,
// returns, POs, GRNs, supplier returns, quotations, stock audits). Replaces
// Redis INCR, which loses its value on a Redis restart/eviction and then
// produces numbers that collide with the unique (pharmacyId, number)
// constraints. `period` scopes each counter to an Indian financial year
// ("2025-2026") — or a single IST day ("20250612") for stock audits — so
// numbering restarts automatically per GST rules.
//
// Increment with one atomic upsert (used inside the billing transaction, which
// also makes invoice numbering GAPLESS — a rolled-back sale returns its number):
//   INSERT ... VALUES (pharmacyId, kind, period, 1)
//   ON CONFLICT DO UPDATE SET value = value + 1 RETURNING value

model DocumentSequence {
  pharmacyId String
  kind       String // INVOICE | SALES_RETURN | PURCHASE_ORDER | GRN | SUPPLIER_RETURN | QUOTATION | STOCK_AUDIT | SUPPLIER_PAYMENT | SUPPLIER_CREDIT_NOTE
  period     String // "2025-2026" (financial year) or "20250612" (IST day, audits)
  value      Int      @default(0)
  updatedAt  DateTime @updatedAt

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@id([pharmacyId, kind, period])
  @@map("document_sequences")
}

// ─── User (Staff) ────────────────────────────────────────────────────────────

model User {
  id                          String    @id @default(cuid())
  pharmacyId                  String
  name                        String
  email                       String
  phone                       String?
  passwordHash                String
  role                        Role      @default(PHARMACIST)
  isActive                    Boolean   @default(true)
  lastLoginAt                 DateTime?
  // Refresh token rotation: increment on every /refresh or logout to invalidate all older tokens
  tokenVersion                Int       @default(0)
  // Password reset (store hashed token; send plaintext to user via email)
  passwordResetToken          String?   @unique
  passwordResetTokenExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy              Pharmacy              @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  invoices              Invoice[]
  auditLogs             AuditLog[]
  invoicePayments       InvoicePayment[]
  salesReturns          SalesReturn[]
  inventoryMovements    InventoryMovement[]
  supplierLedgerEntries SupplierLedgerEntry[]
  quotations            Quotation[]
  calendarEvents        CalendarEvent[]       @relation("CalendarEventCreator")
  ticketsRaised         SupportTicket[]       @relation("TicketRaisedBy")
  ticketMessages        TicketMessage[]       @relation("TicketMessageSender")
  supportAgent          SupportAgent?
  cashClosures          CashClosure[]
  approvedAuditSessions StockAuditSession[]   @relation("StockAuditApprover")
  createdAuditSessions  StockAuditSession[]   @relation("StockAuditCreator")
  approvedPOs           PurchaseOrder[]       @relation("POApprover")
  batchRecalls          BatchRecall[]         @relation("BatchRecallUser")
  migrationSessions     MigrationSession[]

  // Email is the login identifier and must be unique across the whole system,
  // not just within one pharmacy — otherwise two pharmacies could each create
  // a user with the same email and login couldn't tell them apart (it looks
  // up by email alone). See PharmacyOnboardingService, which already relies
  // on email being globally unique.
  @@unique([email])
  @@index([pharmacyId, role])
  @@map("users")
}

enum Role {
  OWNER
  MANAGER
  PHARMACIST
  CASHIER
  SUPPORT_AGENT
  PLATFORM_ADMIN
}

// ─── Medicine (Global — shared across all pharmacies) ────────────────────────

model Medicine {
  id           String  @id @default(cuid())
  name         String
  genericName  String?
  manufacturer String?
  composition  String?
  // category (free text) is kept for backward compat with existing data/API.
  // categoryId (FK) is the structured replacement — use it for new features.
  // When both are set, categoryId wins for filtering; category is the display fallback.
  category     String?
  categoryId   String?
  schedule     String? // OTC, H, X, G
  hsnCode      String?
  gstRate      Decimal @default(12) @db.Decimal(12, 2)
  form         String? // tablet, syrup, injection, cream
  strength     String? // 500mg, 5ml
  unit         String? // strip, bottle, vial, tube
  packSize     String? // 10 tablets, 100ml
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brandId         String?
  brand           Brand?           @relation(fields: [brandId], references: [id])
  productCategory ProductCategory? @relation(fields: [categoryId], references: [id])
  barcode         String?
  boxSize         Int? // strips per box; used with packSize for unit conversion
  catalogMrp      Decimal?         @db.Decimal(12, 2) // reference price — pre-fills GRN form only, never used for billing

  inventory         Inventory[]
  grnItems          GRNItem[]
  quotationItems    QuotationItem[]
  pharmacyOverrides PharmacyMedicineOverride[]
  prescriptionItems PrescriptionItem[]
  batchRecalls      BatchRecall[]
  medicineMappings  MedicineMapping[]

  @@index([name])
  @@index([genericName])
  @@index([hsnCode])
  @@index([category])
  @@index([categoryId])
  @@index([barcode])
  @@index([manufacturer])
  @@index([isActive])
  @@map("medicines")
}

// ─── Per-pharmacy medicine override ──────────────────────────────────────────
// The medicine catalog is GLOBAL and only PLATFORM_ADMIN can mutate it. When a
// single pharmacy needs a different GST rate (e.g. a state-specific ruling or
// a catalog error they cannot wait on) or a standing discount for a medicine,
// the owner records an override here instead of editing the shared record.
// NULL field = "use the catalog value". Applied at billing checkout (the
// authoritative GST computation) and overlaid on pharmacy-scoped inventory
// reads; the global search cache stays untouched.

model PharmacyMedicineOverride {
  pharmacyId         String
  medicineId         String
  gstRate            Decimal? @db.Decimal(12, 2) // null = catalog gstRate
  defaultDiscountPct Decimal? @db.Decimal(12, 2) // standing % discount pre-filled at POS
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@id([pharmacyId, medicineId])
  @@map("pharmacy_medicine_overrides")
}

// ─── Brand (global — shared across all pharmacies) ───────────────────────────

model Brand {
  id           String  @id @default(cuid())
  name         String  @unique
  manufacturer String?
  country      String?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medicines Medicine[]

  @@index([name])
  @@map("brands")
}

// ─── Product Category (global) ───────────────────────────────────────────────

model ProductCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  code        String?
  description String?
  parentId    String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent    ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  ProductCategory[] @relation("CategoryHierarchy")
  medicines Medicine[]

  @@index([name])
  @@map("product_categories")
}

// ─── Inventory (per pharmacy, per batch) ─────────────────────────────────────

model Inventory {
  id               String      @id @default(cuid())
  pharmacyId       String
  medicineId       String
  batchNumber      String
  expiryDate       DateTime
  quantity         Int
  reservedQuantity Int         @default(0)
  purchaseRate     Decimal     @db.Decimal(12, 2)
  mrp              Decimal     @db.Decimal(12, 2)
  location         String?
  shelfId          String?
  minimumStock     Int         @default(10)
  reorderLevel     Int         @default(5)
  status           BatchStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy           Pharmacy            @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicine           Medicine            @relation(fields: [medicineId], references: [id])
  shelf              Shelf?              @relation(fields: [shelfId], references: [id])
  invoiceItems       InvoiceItem[]
  salesReturnItems   SalesReturnItem[]
  inventoryMovements InventoryMovement[]
  stockReservations  StockReservation[]
  grnItems           GRNItem[]
  stockAuditItems    StockAuditItem[]

  @@unique([pharmacyId, medicineId, batchNumber])
  @@index([pharmacyId, medicineId])
  @@index([pharmacyId, expiryDate])
  @@index([pharmacyId, status])
  // Covering index for active-stock and low-stock queries: WHERE pharmacyId=? AND status='ACTIVE' AND quantity>0
  @@index([pharmacyId, status, quantity])
  // Covering index for FEFO batch selection: WHERE pharmacyId=? AND medicineId=? AND status='ACTIVE' ORDER BY expiryDate ASC
  @@index([pharmacyId, medicineId, status, expiryDate])
  // Calibrate DISTINCT ON: WHERE pharmacyId=? AND status='ACTIVE' ORDER BY medicineId, createdAt DESC
  // Allows Postgres to resolve DISTINCT ON without a sort step.
  @@index([pharmacyId, status, medicineId, createdAt(sort: Desc)])
  @@map("inventory")
}

// ─── Stock Reservation ───────────────────────────────────────────────────────
// Created when a billing session adds an item to cart; released when bill is
// saved, cleared, or the TTL expires. Prevents two operators from selling the
// same last strip simultaneously.

model StockReservation {
  id          String   @id @default(cuid())
  pharmacyId  String
  inventoryId String
  sessionId   String // idempotency key of the billing session
  quantity    Int
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  pharmacy  Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([pharmacyId, inventoryId, sessionId])
  @@index([pharmacyId, sessionId])
  @@index([expiresAt])
  @@map("stock_reservations")
}

// ─── Customer ────────────────────────────────────────────────────────────────

model Customer {
  id              String       @id @default(cuid())
  pharmacyId      String
  name            String
  phone           String?
  email           String?
  address         String?
  state           String? // Indian state code (e.g. "MH", "KA") — used for IGST determination
  dateOfBirth     DateTime?
  gender          String?
  abhaNumber      String? // ABHA / Health ID / IPD / OPD number
  cardNumber      String? // Pharmacy loyalty card (unique per pharmacy; NULLs are distinct)
  customerType    CustomerType @default(WALK_IN)
  defaultDiscount Decimal      @default(0) @db.Decimal(12, 2) // auto-applied discount % shown at billing
  creditLimit     Decimal      @default(0) @db.Decimal(12, 2)
  creditUsed      Decimal      @default(0) @db.Decimal(12, 2)
  notes           String?
  deletedAt       DateTime? // soft delete — null = active
  createdById     String? // ID of staff who created (stored as plain ID; preserved on user delete)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy Pharmacy      @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  returns  SalesReturn[]

  @@unique([pharmacyId, cardNumber])
  @@index([pharmacyId, phone])
  @@index([pharmacyId, name])
  @@index([pharmacyId, abhaNumber])
  @@index([pharmacyId, customerType])
  @@index([pharmacyId, deletedAt])
  @@index([pharmacyId, email])
  @@map("customers")
}

enum CustomerType {
  WALK_IN
  REGISTERED
  CORPORATE
  CREDIT
}

// ─── Supplier ────────────────────────────────────────────────────────────────

model Supplier {
  id            String  @id @default(cuid())
  pharmacyId    String
  name          String
  gstin         String?
  dlNumber      String?
  phone         String?
  email         String?
  address       String?
  city          String?
  state         String?
  creditLimit   Decimal @default(0) @db.Decimal(12, 2)
  creditDays    Int     @default(30)
  paymentTerms  String?
  isActive      Boolean @default(true)
  // Running balance: incremented on GRN confirm, decremented on payment or supplier return.
  // Positive = pharmacy owes supplier; negative = supplier owes pharmacy (over-payment or credit).
  // Avoids two aggregate queries on every supplier list / balance badge read.
  ledgerBalance Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy        Pharmacy              @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  purchaseOrders  PurchaseOrder[]
  grns            GoodsReceiptNote[]
  supplierReturns SupplierReturn[]
  ledgerEntries   SupplierLedgerEntry[]
  quotations      Quotation[]

  @@index([pharmacyId])
  @@index([pharmacyId, isActive])
  @@map("suppliers")
}

// ─── Purchase Order ───────────────────────────────────────────────────────────

model PurchaseOrder {
  id              String         @id @default(cuid())
  pharmacyId      String
  supplierId      String
  orderNumber     String
  invoiceNo       String?
  status          PurchaseStatus @default(DRAFT)
  approvalStatus  ApprovalStatus @default(NOT_REQUIRED)
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  subtotal        Decimal        @default(0) @db.Decimal(12, 2)
  totalGst        Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal        @default(0) @db.Decimal(12, 2)
  notes           String?
  expectedDate    DateTime?
  orderedAt       DateTime       @default(now())
  receivedAt      DateTime?
  // Source PDF this PO was drafted from (e.g. supplier quote), if any — see Upload model.
  sourceUploadId  String?
  // Line items, denormalized as JSON — no cross-row aggregation/reporting ever
  // queries into this at the SQL level (verified before this migration), so a
  // child table bought nothing but an extra join. itemCount is maintained
  // alongside it so list views don't need to read/parse the JSON just to show
  // a count (mirrors Supplier.ledgerBalance's running-value pattern below).
  items           Json
  itemCount       Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy     Pharmacy           @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  supplier     Supplier           @relation(fields: [supplierId], references: [id])
  approver     User?              @relation("POApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  sourceUpload Upload?            @relation(fields: [sourceUploadId], references: [id], onDelete: SetNull)
  grns         GoodsReceiptNote[]

  @@unique([pharmacyId, orderNumber])
  @@index([pharmacyId, status])
  @@index([pharmacyId, supplierId])
  @@index([pharmacyId, approvalStatus])
  // Default PO list view: WHERE pharmacyId=? ORDER BY orderedAt DESC (no other filter).
  // Without this the list does a sort on every page load (mirrors the invoices list index).
  @@index([pharmacyId, orderedAt(sort: Desc)])
  @@map("purchase_orders")
}

enum PurchaseStatus {
  DRAFT
  PENDING
  RECEIVED
  PARTIAL
  CANCELLED
}

enum BatchStatus {
  ACTIVE
  QUARANTINE
  EXPIRED
  DAMAGED
}

enum GRNStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

// PurchaseOrderItem removed — folded into PurchaseOrder.items (JSON) above.
// Verified before removal: the only direct table-level query against it was
// a deleteMany during PO edit; no report or cross-row aggregate ever read it.

// ─── Invoice ─────────────────────────────────────────────────────────────────

model Invoice {
  id             String        @id @default(cuid())
  pharmacyId     String
  invoiceNumber  String
  customerId     String?
  // Snapshot of customer name/phone at billing time — avoids JOIN in search queries
  // and preserves the name even if the customer record is later updated.
  customerName   String?
  customerPhone  String?
  userId         String
  doctorId       String?
  doctorName     String?
  // Snapshot doctor registration number at billing time so the audit trail
  // is self-contained even if the doctor record is later edited or deleted.
  doctorRegNo    String?
  prescriptionId String?
  paymentMode    PaymentMode   @default(CASH)
  paymentStatus  PaymentStatus @default(PAID)
  status         InvoiceStatus @default(COMPLETED)
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  taxableAmount  Decimal       @db.Decimal(12, 2)
  cgst           Decimal       @db.Decimal(12, 2)
  sgst           Decimal       @db.Decimal(12, 2)
  igst           Decimal       @default(0) @db.Decimal(12, 2)
  totalGst       Decimal       @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  // Bill-level additions, stored so the invoice can be re-derived from its own row:
  // taxableAmount + totalGst + extraCharges + adjustmentAmount + roundOff = totalAmount.
  // roundOff is signed — the rupee rounding goes either way and prints as its own line.
  extraCharges     Decimal     @default(0) @db.Decimal(12, 2)
  adjustmentAmount Decimal     @default(0) @db.Decimal(12, 2)
  roundOff         Decimal     @default(0) @db.Decimal(12, 2)
  returnedAmount Decimal       @default(0) @db.Decimal(12, 2)
  isInterstate   Boolean       @default(false)
  notes          String?
  isCancelled    Boolean       @default(false)
  cancelledAt    DateTime?
  cancelReason   String?
  idempotencyKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy     Pharmacy         @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  customer     Customer?        @relation(fields: [customerId], references: [id])
  doctor       Doctor?          @relation(fields: [doctorId], references: [id])
  user         User             @relation(fields: [userId], references: [id])
  prescription Prescription?    @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  items        InvoiceItem[]
  payments     InvoicePayment[]
  returns      SalesReturn[]

  @@unique([pharmacyId, invoiceNumber])
  @@unique([pharmacyId, idempotencyKey])
  @@index([pharmacyId, createdAt])
  @@index([pharmacyId, customerId])
  @@index([pharmacyId, status])
  // Covering index for pending-credit queries: WHERE pharmacyId=? AND paymentStatus='PENDING' AND isCancelled=false
  @@index([pharmacyId, paymentStatus, isCancelled])
  // Covering index for filtered invoice list sorted by date (most common view)
  @@index([pharmacyId, isCancelled, createdAt(sort: Desc)])
  // Doctor-wise prescription report (full scan without this)
  @@index([pharmacyId, doctorId])
  // Cashier-wise billing report
  @@index([pharmacyId, userId])
  @@map("invoices")
}

// ─── Prescription ─────────────────────────────────────────────────────────────
// Structured prescription record linking a scanned upload to doctor + patient
// details and the list of drugs prescribed. Required for Schedule H / H1 / X
// drugs under the Drugs & Cosmetics Act before dispensing.

model Prescription {
  id                 String             @id @default(cuid())
  pharmacyId         String
  prescriptionNumber String
  doctorId           String?
  doctorName         String
  doctorRegNo        String? // MCI / state council registration number
  doctorPhone        String?
  patientName        String
  patientAge         Int?
  patientPhone       String?
  patientGender      String?
  uploadId           String? // scanned prescription image
  prescribedDate     DateTime?
  validUntil         DateTime?
  status             PrescriptionStatus @default(ACTIVE)
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy Pharmacy           @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  doctor   Doctor?            @relation(fields: [doctorId], references: [id])
  upload   Upload?            @relation(fields: [uploadId], references: [id])
  invoices Invoice[]
  items    PrescriptionItem[]

  @@unique([pharmacyId, prescriptionNumber])
  @@index([pharmacyId, status])
  @@index([pharmacyId, doctorId])
  @@index([pharmacyId, createdAt])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String  @id @default(cuid())
  pharmacyId     String
  prescriptionId String
  medicineName   String
  medicineId     String?
  schedule       String? // H, H1, X, G, OTC
  quantity       Int
  dispensedQty   Int     @default(0)
  dosage         String?
  duration       String?
  notes          String?

  createdAt DateTime @default(now())

  pharmacy     Pharmacy     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine     Medicine?    @relation(fields: [medicineId], references: [id])

  @@index([pharmacyId])
  @@index([prescriptionId])
  @@map("prescription_items")
}

enum PrescriptionStatus {
  ACTIVE
  PARTIAL
  DISPENSED
  EXPIRED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  COMPLETED
  CANCELLED
  RETURNED
  PARTIALLY_RETURNED
}

enum PaymentMode {
  CASH
  UPI
  CARD
  CREDIT
  WALLET
}

enum PaymentStatus {
  PAID
  PENDING
  PARTIAL
}

model InvoiceItem {
  id            String   @id @default(cuid())
  pharmacyId    String
  invoiceId     String
  inventoryId   String
  medicineName  String
  hsnCode       String?
  batchNumber   String
  expiryDate    DateTime
  quantity      Int
  // Scheme quantity handed over free with this line (10+1, buy-100-get-10).
  // NOT charged: taxableAmount/amount are derived from `quantity` alone. It IS
  // deducted from stock, because the goods physically leave the shelf — the batch
  // is decremented by quantity + freeQty.
  freeQty       Int      @default(0)
  mrp           Decimal  @db.Decimal(12, 2)
  rate          Decimal  @db.Decimal(12, 2)
  purchaseRate  Decimal  @default(0) @db.Decimal(12, 2)
  discount      Decimal  @default(0) @db.Decimal(12, 2)
  gstRate       Decimal  @db.Decimal(12, 2)
  cgst          Decimal  @db.Decimal(12, 2)
  sgst          Decimal  @db.Decimal(12, 2)
  igst          Decimal  @default(0) @db.Decimal(12, 2)
  taxableAmount Decimal  @db.Decimal(12, 2)
  amount        Decimal  @db.Decimal(12, 2)
  location      String?

  pharmacy         Pharmacy          @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  invoice          Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  inventory        Inventory         @relation(fields: [inventoryId], references: [id])
  salesReturnItems SalesReturnItem[]

  @@index([pharmacyId])
  @@index([invoiceId])
  @@index([inventoryId])
  @@map("invoice_items")
}

// ─── Invoice Payments (split payment support) ────────────────────────────────

model InvoicePayment {
  id          String      @id @default(cuid())
  pharmacyId  String
  invoiceId   String
  amount      Decimal     @db.Decimal(12, 2)
  paymentMode PaymentMode
  reference   String?
  notes       String?
  paidAt      DateTime    @default(now())
  createdBy   String

  pharmacy      Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdByUser User     @relation(fields: [createdBy], references: [id])

  @@index([invoiceId])
  @@index([pharmacyId, paidAt])
  @@map("invoice_payments")
}

// ─── Sales Return ─────────────────────────────────────────────────────────────

model SalesReturn {
  id             String  @id @default(cuid())
  pharmacyId     String
  invoiceId      String
  returnNumber   String
  reason         String?
  userId         String
  customerId     String?
  subtotal       Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxableAmount  Decimal @db.Decimal(12, 2)
  cgst           Decimal @db.Decimal(12, 2)
  sgst           Decimal @db.Decimal(12, 2)
  igst           Decimal @default(0) @db.Decimal(12, 2)
  totalGst       Decimal @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)
