generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Tenant Status (Platform Admin lifecycle) ────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
  PENDING
  TRIAL
  EXPIRED
}

// ─── Pharmacy (one per registered pharmacy) ──────────────────────────────────

model Pharmacy {
  id              String       @id @default(cuid())
  tenantCode      String?      @unique // e.g. TEN-000001 — generated on create
  name            String
  slug            String       @unique
  gstin           String?
  drugLicense     String?
  phone           String?
  email           String?
  address         String?
  city            String?
  state           String?
  pincode         String?
  isActive        Boolean      @default(true)
  tenantStatus    TenantStatus @default(ACTIVE)
  logoUrl         String? // Supabase storage path; signed on read
  documents       Json? // StoredDoc[] — compliance doc metadata (number, expiry, file path)
  // Per-pharmacy invoice/GST/numbering config (1:1, was the InvoiceSettings table).
  // Inlined as a column — it was a strict 1:1 holding a single JSON blob, only ever
  // read by pharmacyId and written via upsert, so a separate table bought nothing.
  invoiceSettings Json?
  // Billing-screen action config: which save actions exist, which are pinned to the
  // Save dropdown, and their order. Pharmacy-level rather than per-user — deciding
  // "we don't do home delivery" is a shop policy, not a cashier's preference, and it
  // must look the same on every till. Same shape and lifecycle as invoiceSettings.
  billingPreferences Json?
  // Which batch the dispensing engine picks when a medicine has several in stock
  // (see DispensingService, Java). LILA_FEFO — earliest valid expiry first — is the
  // safe default and what nearly every pharmacy wants; LIFA (newest received stock
  // first) is a deliberate opt-in. Shop policy, not a per-bill or per-cashier choice:
  // it is one enum here, snapshotted onto each Invoice at billing time so a later
  // change never rewrites what a past bill actually did.
  dispensingStrategy DispensingStrategy @default(LILA_FEFO)
  // Per-pharmacy EMR machine-to-machine HMAC secret, AES-256-GCM at rest (see
  // EmrSecretCipher / EmrHmacAuthenticationFilter). Null until the pharmacy
  // generates one from its own Integrations screen; the EMR integration route
  // fails closed when any of the three is absent. Never a shared/global secret
  // — that was the cross-tenant impersonation gap this replaces.
  emrSecretCiphertext String?
  emrSecretIv         String?
  emrSecretTag        String?
  // SHA-256 of the plaintext key (ApiSecretHasher), written alongside the ciphertext at the
  // one moment the plaintext exists server-side. Lets ClinicPairingService look up a
  // presented pairing code by an indexed equality match instead of decrypting every
  // pharmacy's secret to compare plaintexts — see migration 20260823000002.
  emrSecretLookupHash String?
  // The clinic this pharmacy is connected to, as entered on the Integrations
  // screen. emrCallbackUrl is where dispensing updates are POSTed back; the
  // clinic's own connection id is part of that URL, which is why it has to be
  // per-pharmacy and not one process-wide address.
  emrClinicName   String?
  emrCallbackUrl  String?
  emrConnectedAt  DateTime?
  // Automatic pairing (see 20260820000001). The clinic presents the code the
  // pharmacist generated and hands over where to reach it plus the secret to
  // sign callbacks with; we answer with a credential scoped to that clinic.
  //
  // emrApiKey is an identifier — it travels in a header on every request and is
  // what we look the pharmacy up by, so it is stored in the clear and indexed.
  // emrApiSecretHash is SHA-256: this is a 256-bit CSPRNG token, not a human
  // password, so a slow KDF would add latency to every machine request and buy
  // nothing. Shown once at pairing and never recoverable — re-pair instead.
  emrClinicExternalId String?
  emrClinicLinkId     String?
  emrPairedAt         DateTime?
  emrApiKey           String?   @unique
  emrApiSecretHash    String?
  // The CLINIC's webhook secret, held so our dispense callback can be signed the
  // way that clinic verifies. Encrypted at rest exactly like emrSecret* — it is
  // somebody else's credential, which is a reason for more care, not less.
  //
  // Its presence is also the dialect discriminator: holding one means this link
  // was paired through the compatibility route and its callbacks are signed the
  // clinic's way. The secret IS what you sign with, so having it and using it
  // cannot drift apart the way a boolean flag could.
  emrWebhookSecretCiphertext String?
  emrWebhookSecretIv         String?
  emrWebhookSecretTag        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  customers             Customer[]
  suppliers             Supplier[]
  inventory             Inventory[]
  purchaseOrders        PurchaseOrder[]
  invoices              Invoice[]
  auditLogs             AuditLog[]
  uploads               Upload[]
  notifications         NotificationLog[]
  invoicePayments       InvoicePayment[]
  salesReturns          SalesReturn[]
  inventoryMovements    InventoryMovement[]
  stockReservations     StockReservation[]
  grns                  GoodsReceiptNote[]
  supplierReturns       SupplierReturn[]
  supplierLedgerEntries SupplierLedgerEntry[]
  customerLedgerEntries CustomerLedgerEntry[]
  quotations            Quotation[]
  racks                 Rack[]
  shelves               Shelf[]
  stockAuditSessions    StockAuditSession[]
  calendarEvents        CalendarEvent[]
  supportTickets        SupportTicket[]
  documentSequences     DocumentSequence[]
  medicineOverrides     PharmacyMedicineOverride[]
  doctors               Doctor[]
  cashClosures          CashClosure[]
  subscription          Subscription?
  tenantSettings        TenantSettings?
  // Child-table back-relations (added for RLS + tenant isolation on item rows)
  invoiceItems          InvoiceItem[]
  grnItems              GRNItem[]
  salesReturnItems      SalesReturnItem[]
  quotationItems        QuotationItem[]
  stockAuditItems       StockAuditItem[]
  ticketMessages        TicketMessage[]
  ticketAttachments     TicketAttachment[]
  prescriptions         Prescription[]
  prescriptionItems     PrescriptionItem[]
  batchRecalls          BatchRecall[]
  migrationSessions     MigrationSession[]
  migrationImportJobs   MigrationImportJob[]
  medicineMappings      MedicineMapping[]
  pharmacyMedicines     PharmacyMedicine[]
  packSizeSignals       PackSizeSignal[]

  @@map("pharmacies")
}

// ─── Subscription (one per pharmacy, platform-managed) ────────────────────────

model Subscription {
  id            String             @id @default(cuid())
  pharmacyId    String             @unique
  planName      String             @default("Free") // Free | Standard | Professional | Enterprise
  status        SubscriptionStatus @default(ACTIVE)
  billingCycle  String             @default("MONTHLY") // MONTHLY | YEARLY | QUARTERLY
  amount        Float? // price for current plan cycle
  autoRenew     Boolean            @default(true)
  validUntil    DateTime
  trialEndsAt   DateTime?
  pausedAt      DateTime?
  cancelledAt   DateTime?
  discount      Float              @default(0) // percentage
  couponCode    String?
  creditBalance Float              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy  Pharmacy               @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  invoices  SubscriptionInvoice[]
  auditLogs SubscriptionAuditLog[]

  @@index([status])
  @@index([validUntil])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  PAUSED
  EXPIRED
  CANCELLED
}

// ─── Subscription Invoice ─────────────────────────────────────────────────────

model SubscriptionInvoice {
  id             String               @id @default(cuid())
  subscriptionId String
  pharmacyId     String
  invoiceNumber  String               @unique
  amount         Float
  tax            Float                @default(0)
  discount       Float                @default(0)
  total          Float
  couponCode     String?
  status         InvoicePaymentStatus @default(PENDING)
  dueDate        DateTime
  paidAt         DateTime?
  gstinPharmacy  String?
  gstinPlatform  String?

  createdAt DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([pharmacyId])
  @@map("subscription_invoices")
}

enum InvoicePaymentStatus {
  PAID
  PENDING
  OVERDUE
  CANCELLED
  REFUNDED
}

// ─── Subscription Audit Log ───────────────────────────────────────────────────

model SubscriptionAuditLog {
  id             String  @id @default(cuid())
  subscriptionId String
  action         String // PLAN_CHANGED, RENEWED, PAUSED, RESUMED, CANCELLED, INVOICE_GENERATED, REMINDER_SENT
  oldValue       String? // JSON
  newValue       String? // JSON
  performedBy    String // user id

  createdAt DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("subscription_audit_logs")
}

// ─── Tenant Settings (feature flags & limits per pharmacy) ────────────────────

model TenantSettings {
  id                  String  @id @default(cuid())
  pharmacyId          String  @unique
  doctorLimit         Int     @default(5)
  staffLimit          Int     @default(5)
  patientLimit        Int     @default(500)
  storageLimit        Int     @default(1024) // in MB
  enableBilling       Boolean @default(true)
  enableInventory     Boolean @default(true)
  enableEmr           Boolean @default(false)
  enableCrm           Boolean @default(false)
  enableWhatsapp      Boolean @default(false)
  enableSms           Boolean @default(false)
  enableApiAccess     Boolean @default(false)
  enableOnlineBooking Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

// ─── Document Sequence ────────────────────────────────────────────────────────
// Transactional per-pharmacy counters for all document numbers (invoices,
// returns, POs, GRNs, supplier returns, quotations, stock audits). Replaces
// Redis INCR, which loses its value on a Redis restart/eviction and then
// produces numbers that collide with the unique (pharmacyId, number)
// constraints. `period` scopes each counter to an Indian financial year
// ("2025-2026") — or a single IST day ("20250612") for stock audits — so
// numbering restarts automatically per GST rules.
//
// Increment with one atomic upsert (used inside the billing transaction, which
// also makes invoice numbering GAPLESS — a rolled-back sale returns its number):
//   INSERT ... VALUES (pharmacyId, kind, period, 1)
//   ON CONFLICT DO UPDATE SET value = value + 1 RETURNING value

model DocumentSequence {
  pharmacyId String
  kind       String // INVOICE | SALES_RETURN | PURCHASE_ORDER | GRN | SUPPLIER_RETURN | QUOTATION | STOCK_AUDIT | SUPPLIER_PAYMENT | SUPPLIER_CREDIT_NOTE
  period     String // "2025-2026" (financial year) or "20250612" (IST day, audits)
  value      Int      @default(0)
  updatedAt  DateTime @updatedAt

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@id([pharmacyId, kind, period])
  @@map("document_sequences")
}

// ─── User (Staff) ────────────────────────────────────────────────────────────

model User {
  id                          String    @id @default(cuid())
  pharmacyId                  String
  name                        String
  email                       String
  phone                       String?
  passwordHash                String
  role                        Role      @default(PHARMACIST)
  isActive                    Boolean   @default(true)
  lastLoginAt                 DateTime?
  // Refresh token rotation: increment on every /refresh or logout to invalidate all older tokens
  tokenVersion                Int       @default(0)
  // Password reset (store hashed token; send plaintext to user via email)
  passwordResetToken          String?   @unique
  passwordResetTokenExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy              Pharmacy              @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  invoices              Invoice[]
  auditLogs             AuditLog[]
  invoicePayments       InvoicePayment[]
  salesReturns          SalesReturn[]
  inventoryMovements    InventoryMovement[]
  supplierLedgerEntries SupplierLedgerEntry[]
  customerLedgerEntries CustomerLedgerEntry[]
  quotations            Quotation[]
  calendarEvents        CalendarEvent[]       @relation("CalendarEventCreator")
  ticketsRaised         SupportTicket[]       @relation("TicketRaisedBy")
  ticketMessages        TicketMessage[]       @relation("TicketMessageSender")
  supportAgent          SupportAgent?
  cashClosures          CashClosure[]
  approvedAuditSessions StockAuditSession[]   @relation("StockAuditApprover")
  createdAuditSessions  StockAuditSession[]   @relation("StockAuditCreator")
  approvedPOs           PurchaseOrder[]       @relation("POApprover")
  batchRecalls          BatchRecall[]         @relation("BatchRecallUser")
  migrationSessions     MigrationSession[]
  createdGrns           GoodsReceiptNote[]    @relation("GrnCreator")
  confirmedGrns         GoodsReceiptNote[]    @relation("GrnConfirmer")

  // Email is the login identifier and must be unique across the whole system,
  // not just within one pharmacy — otherwise two pharmacies could each create
  // a user with the same email and login couldn't tell them apart (it looks
  // up by email alone). See PharmacyOnboardingService, which already relies
  // on email being globally unique.
  @@unique([email])
  @@index([pharmacyId, role])
  @@map("users")
}

enum Role {
  OWNER
  MANAGER
  PHARMACIST
  CASHIER
  SUPPORT_AGENT
  PLATFORM_ADMIN
}

// ─── Medicine (Global — shared across all pharmacies) ────────────────────────

// How much a medicine's `unitsPerPack` may be trusted.
//
// The pack multiple is a DIVISOR: every mL→bottle conversion, every per-piece
// price and every loose sale runs through it, and when it is wrong the
// arithmetic downstream stays perfectly correct while the answer is absurd (a
// 40 ml course billed as eight bottles against a 5 ml "pack size" that was
// really the 5% concentration). Nothing in the chain held a second fact that
// could contradict the first — this column is that second fact, carried on the
// row itself so every screen can see how the number got there.
//
// NULL whenever `unitsPerPack` is NULL: nothing is classified, so there is
// nothing to trust or distrust. That is deliberately NOT the same as UNVERIFIED.
enum PackSizeConfidence {
  // Two independent facts agree, or a human confirmed it against a physical pack.
  VERIFIED
  // A pack size is on record and nothing corroborates it. Still used — billing
  // must not stop because a datum is merely unaudited — but flagged in the UI.
  UNVERIFIED
  // The pack size contradicts another fact on the same SKU (it equals a strength
  // or concentration figure, or a measured medicine claims a 1 ml/1 g pack).
  // Rejected outright on the service write path; this state exists for the rows
  // that predate the guard and for anything that reaches the table another way.
  DISPUTED
}

// Where the pack size currently on the row came from. Kept beside the confidence
// because "who said so" and "how sure are we" answer different questions: a
// pharmacist's tick and a bulk CSV can both land on VERIFIED, and only this
// column says which one to go back to when it turns out to be wrong.
enum PackSizeSource {
  // A platform admin typed it into the shared catalogue form.
  CATALOGUE_ADMIN
  // A pharmacist confirmed it against a pack in their hand.
  PHARMACIST
  // Corroborated by the medicine's own free-text `packSize` ("100 ml bottle").
  PACK_SIZE_TEXT
  // A row in a bulk catalogue upload.
  BULK_IMPORT
  // Resolved while ingesting a clinic prescription.
  EMR_INGEST
  // One of packages/database/scripts — a repair run, not a workflow.
  DATA_SCRIPT
  // Written straight to the table, bypassing the service layer entirely (psql,
  // Prisma Studio, a future service that does not know about this column).
  // Stamped by the `medicines_stamp_unverified_pack_size` trigger, never by app code.
  RAW_WRITE
  // Classified before this column existed — see migration 20260910000001.
  BACKFILL
}

model Medicine {
  id           String  @id @default(cuid())
  name         String
  genericName  String?
  manufacturer String?
  composition  String?
  // category (free text) is kept for backward compat with existing data/API.
  // categoryId (FK) is the structured replacement — use it for new features.
  // When both are set, categoryId wins for filtering; category is the display fallback.
  category     String?
  categoryId   String?
  schedule     String? // OTC, H, X, G
  hsnCode      String?
  gstRate      Decimal @default(12) @db.Decimal(12, 2)
  form         String? // tablet, syrup, injection, cream
  strength     String? // 500mg, 5ml
  unit         String? // strip, bottle, vial, tube
  packSize     String? // 10 tablets, 100ml
  // Structured pack multiple: base units (tablets/capsules/mL) in one sellable pack.
  // Authoritative for loose ("cut strip") dispensing and per-piece pricing; packSize
  // above stays the free-text label. NULL = not classified — no loose sale without it.
  unitsPerPack Int?
  // TABLET | CAPSULE | ML | GM | EACH — the smallest dispensable unit. Label only for now.
  baseUnit     String?
  // ── How far to trust `unitsPerPack` above ──────────────────────────────────
  // Written by the service layer (see PackSizeEvidence) on every write that sets
  // or changes the packaging. A write that reaches this table WITHOUT going
  // through that path is forced to UNVERIFIED / RAW_WRITE by a BEFORE trigger, so
  // "nobody has checked this" is the default a bad datum lands on rather than a
  // state something has to remember to set. NULL only while unitsPerPack is NULL.
  packSizeConfidence PackSizeConfidence?
  // When a human last confirmed the pack size against a physical pack. Set only
  // alongside VERIFIED, cleared whenever confidence drops back below it.
  packSizeVerifiedAt DateTime?
  packSizeSource     PackSizeSource?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brandId         String?
  brand           Brand?           @relation(fields: [brandId], references: [id])
  productCategory ProductCategory? @relation(fields: [categoryId], references: [id])
  barcode         String?
  boxSize         Int? // strips per box; used with packSize for unit conversion
  catalogMrp      Decimal?         @db.Decimal(12, 2) // reference price — pre-fills GRN form only, never used for billing

  inventory         Inventory[]
  grnItems          GRNItem[]
  quotationItems    QuotationItem[]
  pharmacyOverrides PharmacyMedicineOverride[]
  prescriptionItems PrescriptionItem[]
  batchRecalls      BatchRecall[]
  medicineMappings  MedicineMapping[]
  pharmacyMedicines PharmacyMedicine[]
  packSizeSignals   PackSizeSignal[]

  @@index([name])
  @@index([genericName])
  @@index([hsnCode])
  @@index([category])
  @@index([categoryId])
  @@index([barcode])
  @@index([manufacturer])
  @@index([isActive])
  @@map("medicines")
}

// ─── Pack-size signal (the self-healing feedback loop) ───────────────────────
//
// One observation that the catalogue's pack size may be wrong, recorded at the only
// moment anybody actually finds out: a pharmacist reaching for the shelf, seeing what
// the engine asked for, and handing over a different number of packs instead.
//
// WHY THIS IS THE RIGHT SIGNAL
//   Phase 1 gave the conversion a plausibility ceiling and Phase 2 recorded whether
//   anyone had checked the divisor, but both are guesses made without ever seeing the
//   product. The counter is where the guess meets the bottle. When the engine says eight
//   bottles and the pharmacist hands over one, that disagreement is the single most
//   informative event in the whole system about what the pack really holds — and until
//   now it was thrown away the instant the bill was saved.
//
// WHY ONE SIGNAL IS NOT ENOUGH, AND WHY THIS IS NOT A CORRECTION
//   Overriding the engine is a perfectly ordinary thing to do for perfectly ordinary
//   reasons: the patient wanted less, the shelf was short, the doctor was called. Any
//   single override is far more likely to be one of those than a catalogue error. So a
//   signal asserts nothing on its own. It is a vote, and only a QUORUM of them — across
//   more than one pharmacy, agreeing about roughly what the pack must hold — is treated
//   as evidence. Even then the outcome is quarantine (packSizeConfidence = DISPUTED) and
//   a review task, never an automatic rewrite of the volume. Nothing in this table has
//   held the bottle either.
//
// Rows are kept after they are counted (resolvedAt), not deleted: the evidence a
// quarantine was based on has to survive the quarantine for anyone to review it.
model PackSizeSignal {
  id         String @id @default(cuid())
  pharmacyId String
  medicineId String
  // Where it happened. Nullable so a signal outlives a deleted invoice rather than
  // being cascaded away — the evidence matters more than the receipt.
  invoiceId          String?
  prescriptionItemId String?

  // What the dispensing engine asked for, and what actually went over the counter.
  enginePackCount Int
  actualPackCount Int
  // The clinical figure the conversion started from ("40 ml"), and the divisor it used.
  clinicalVolume   Decimal @db.Decimal(12, 2)
  declaredPackSize Int
  // clinicalVolume / actualPackCount — what one pack would have to hold for the
  // pharmacist's count to be the right one. A lower bound on the truth, not the truth:
  // 40 ml handed over as one bottle implies "at least 40", when the bottle is really 60.
  // Good enough to prove a declared 5 ml wrong, which is all it is ever asked to do.
  impliedPackSize Int

  createdAt DateTime @default(now())
  // Not an append-only row: the quorum sweep stamps resolvedAt afterwards, so this
  // carries updatedAt and maps to BaseEntity rather than CreatedAtEntity (whose
  // javadoc is explicit that a mutable lifecycle needs the column).
  updatedAt DateTime @updatedAt
  // Stamped once a quorum sweep has counted this signal, so a medicine is not
  // re-quarantined every night off the same handful of votes.
  resolvedAt     DateTime?
  resolutionNote String?

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  invoice  Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  // The quorum sweep's own access path: open signals, grouped by medicine.
  @@index([medicineId, resolvedAt])
  @@index([pharmacyId, createdAt])
  @@map("pack_size_signals")
}

// ─── Per-pharmacy medicine override ──────────────────────────────────────────
// The medicine catalog is GLOBAL and only PLATFORM_ADMIN can mutate it. When a
// single pharmacy needs a different GST rate (e.g. a state-specific ruling or
// a catalog error they cannot wait on) or a standing discount for a medicine,
// the owner records an override here instead of editing the shared record.
// NULL field = "use the catalog value". Applied at billing checkout (the
// authoritative GST computation) and overlaid on pharmacy-scoped inventory
// reads; the global search cache stays untouched.

model PharmacyMedicineOverride {
  pharmacyId         String
  medicineId         String
  gstRate            Decimal? @db.Decimal(12, 2) // null = catalog gstRate
  defaultDiscountPct Decimal? @db.Decimal(12, 2) // standing % discount pre-filled at POS
  // This pharmacy may break a pack of this medicine and sell loose pieces at the
  // POS. Needs an effective unitsPerPack > 1. Per-pharmacy on purpose: one shop
  // cuts strips, another only sells sealed.
  allowLooseSale     Boolean  @default(false)
  // A shop that breaks every strip: new POS lines for this medicine start as LOOSE.
  looseByDefault     Boolean  @default(false)
  // Set once the pharmacist has eyeballed the pack size against a real strip
  // (per-piece price x pack should equal the MRP). Lets a report flag the rest.
  looseConfirmedAt   DateTime?
  // Per-pharmacy pack size, for a medicine the shared catalogue hasn't classified
  // (or got wrong). Billing uses COALESCE(this, medicine.unitsPerPack).
  unitsPerPack       Int?
  // The exact pack size this pharmacy last checked against a physical pack, and when —
  // re-stamped on every confirmation, unlike looseConfirmedAt. The pack size billing divides
  // by counts as VERIFIED here only while it still equals this number. Never written to the
  // shared catalogue: one shop's check vouches for its own billing, not everyone's.
  confirmedUnitsPerPack Int?
  packSizeConfirmedAt   DateTime?
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@id([pharmacyId, medicineId])
  @@map("pharmacy_medicine_overrides")
}

// ─── Pharmacy-local medicine (GRN receiving must never block on the global catalog) ─
// A pharmacy-owned stand-in identity for a medicine that GRN received but the global
// `Medicine` catalog doesn't (yet) know. GRNItem.localMedicineId / Inventory.localMedicineId
// point here instead of at `Medicine` — exactly one of medicineId/localMedicineId is set on
// either table (enforced by a CHECK constraint added in migration 20260904000001, not
// representable in this DSL). Carries only what billing/GST-reporting need to snapshot onto
// an InvoiceItem, mirroring the equivalent Medicine columns by name.
//
// `linkedMedicineId` is the eventual global-catalog link, set by the background matcher
// (deterministic tiers only) or a pharmacist's manual confirm — set once, and existing
// GRNItem/Inventory/InvoiceItem rows are never rewritten when it changes; only future lookups
// benefit. A fuzzy (trigram) candidate is never auto-linked here, only ever surfaced for a
// human to confirm — see MedicineMatchStatus.SUGGESTED.
model PharmacyMedicine {
  id           String  @id @default(cuid())
  pharmacyId   String
  name         String
  manufacturer String?
  genericName  String?
  strength     String?
  form         String? // tablet, syrup, injection, cream — mirrors Medicine.form
  unit         String? // strip, bottle, vial, tube — mirrors Medicine.unit
  hsnCode      String?
  gstRate      Decimal @db.Decimal(12, 2) // always supplied from the GRN line, never defaulted
  schedule     String? // OTC, H, X, G — kept so a local scheduled drug still hits the Schedule-H gate

  linkedMedicineId String?
  matchStatus      MedicineMatchStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy       Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  linkedMedicine Medicine? @relation(fields: [linkedMedicineId], references: [id], onDelete: SetNull)
  grnItems       GRNItem[]
  inventory      Inventory[]

  // A case-insensitive unique constraint on (pharmacyId, name) also exists in the
  // database — added in migration 20260905000002 as a functional index (LOWER(name)),
  // not representable in this DSL. The app takes a transaction-scoped advisory lock
  // before find-or-create (see AdvisoryLock) so this should never actually fire; it is
  // the backstop, not the primary defense.
  @@index([pharmacyId, name])
  @@index([pharmacyId, matchStatus])
  @@map("pharmacy_medicines")
}

enum MedicineMatchStatus {
  PENDING
  SUGGESTED
  LINKED
  KEPT_LOCAL
}

// ─── Brand (global — shared across all pharmacies) ───────────────────────────

model Brand {
  id           String  @id @default(cuid())
  name         String  @unique
  manufacturer String?
  country      String?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medicines Medicine[]

  @@index([name])
  @@map("brands")
}

// ─── Product Category (global) ───────────────────────────────────────────────

model ProductCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  code        String?
  description String?
  parentId    String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent    ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  ProductCategory[] @relation("CategoryHierarchy")
  medicines Medicine[]

  @@index([name])
  @@map("product_categories")
}

// ─── Inventory (per pharmacy, per batch) ─────────────────────────────────────

model Inventory {
  id               String      @id @default(cuid())
  pharmacyId       String
  // Exactly one of medicineId/localMedicineId is set — CHECK constraint added in
  // migration 20260904000001 (not representable in this DSL). A row with
  // localMedicineId set is stock GRN received for a medicine not yet in the
  // global catalog; see PharmacyMedicine.
  medicineId       String?
  localMedicineId  String?
  batchNumber      String
  expiryDate       DateTime
  quantity         Int
  // Loose pieces left over from a pack broken open for a cut-strip sale. Always
  // < the medicine's unitsPerPack. Total pieces on hand =
  // quantity * unitsPerPack + looseUnits. 0 for every legacy / pack-only batch.
  looseUnits       Int         @default(0)
  reservedQuantity Int         @default(0)
  purchaseRate     Decimal     @db.Decimal(12, 2)
  mrp              Decimal     @db.Decimal(12, 2)
  location         String?
  shelfId          String?
  minimumStock     Int         @default(10)
  reorderLevel     Int         @default(5)
  status           BatchStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy           Pharmacy            @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicine           Medicine?           @relation(fields: [medicineId], references: [id])
  localMedicine      PharmacyMedicine?   @relation(fields: [localMedicineId], references: [id])
  shelf              Shelf?              @relation(fields: [shelfId], references: [id])
  invoiceItems       InvoiceItem[]
  salesReturnItems   SalesReturnItem[]
  inventoryMovements InventoryMovement[]
  stockReservations  StockReservation[]
  grnItems           GRNItem[]
  stockAuditItems    StockAuditItem[]

  // NULL is never equal to NULL in a standard unique constraint, so this does not
  // prevent duplicate (pharmacyId, batchNumber) rows across two localMedicineId
  // batches — that is enforced instead by a partial unique index on
  // (pharmacyId, localMedicineId, batchNumber) WHERE localMedicineId IS NOT NULL,
  // added in migration 20260904000001 (not representable in this DSL).
  @@unique([pharmacyId, medicineId, batchNumber])
  @@index([pharmacyId, medicineId])
  @@index([pharmacyId, localMedicineId])
  @@index([pharmacyId, expiryDate])
  @@index([pharmacyId, status])
  // Covering index for active-stock and low-stock queries: WHERE pharmacyId=? AND status='ACTIVE' AND quantity>0
  @@index([pharmacyId, status, quantity])
  // Covering index for FEFO batch selection: WHERE pharmacyId=? AND medicineId=? AND status='ACTIVE' ORDER BY expiryDate ASC
  @@index([pharmacyId, medicineId, status, expiryDate])
  // Calibrate DISTINCT ON: WHERE pharmacyId=? AND status='ACTIVE' ORDER BY medicineId, createdAt DESC
  // Allows Postgres to resolve DISTINCT ON without a sort step.
  @@index([pharmacyId, status, medicineId, createdAt(sort: Desc)])
  @@map("inventory")
}

// ─── Stock Reservation ───────────────────────────────────────────────────────
// Created when a billing session adds an item to cart; released when bill is
// saved, cleared, or the TTL expires. Prevents two operators from selling the
// same last strip simultaneously.

model StockReservation {
  id          String   @id @default(cuid())
  pharmacyId  String
  inventoryId String
  sessionId   String // idempotency key of the billing session
  quantity    Int
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  pharmacy  Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([pharmacyId, inventoryId, sessionId])
  @@index([pharmacyId, sessionId])
  @@index([expiresAt])
  @@map("stock_reservations")
}

// ─── Customer ────────────────────────────────────────────────────────────────

model Customer {
  id              String       @id @default(cuid())
  pharmacyId      String
  name            String
  phone           String?
  email           String?
  address         String?
  state           String? // Indian state code (e.g. "MH", "KA") — used for IGST determination
  dateOfBirth     DateTime?
  gender          String?
  abhaNumber      String? // ABHA / Health ID / IPD / OPD number
  cardNumber      String? // Pharmacy loyalty card (unique per pharmacy; NULLs are distinct)
  customerType    CustomerType @default(WALK_IN)
  defaultDiscount Decimal      @default(0) @db.Decimal(12, 2) // auto-applied discount % shown at billing
  creditLimit     Decimal      @default(0) @db.Decimal(12, 2)
  // Cached dues balance — what this customer owes us. The authoritative value is
  // SUM(CustomerLedgerEntry.duesDelta); this column exists so the hot path
  // (billing, receivables) needs no aggregate. Only ever moved under the row lock
  // in CustomerRepository#lockByIdAndPharmacyId.
  creditUsed      Decimal      @default(0) @db.Decimal(12, 2)
  // Cached advance balance — money we hold for this customer against future bills.
  // Mirror of creditUsed: SUM(CustomerLedgerEntry.advanceDelta).
  advanceBalance  Decimal      @default(0) @db.Decimal(12, 2)
  notes           String?
  deletedAt       DateTime? // soft delete — null = active
  createdById     String? // ID of staff who created (stored as plain ID; preserved on user delete)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy      Pharmacy              @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  invoices      Invoice[]
  returns       SalesReturn[]
  ledgerEntries CustomerLedgerEntry[]

  @@unique([pharmacyId, cardNumber])
  @@index([pharmacyId, phone])
  @@index([pharmacyId, name])
  @@index([pharmacyId, abhaNumber])
  @@index([pharmacyId, customerType])
  @@index([pharmacyId, deletedAt])
  @@index([pharmacyId, email])
  @@map("customers")
}

enum CustomerType {
  WALK_IN
  REGISTERED
  CORPORATE
  CREDIT
}

// ─── Supplier ────────────────────────────────────────────────────────────────

model Supplier {
  id            String  @id @default(cuid())
  pharmacyId    String
  name          String
  gstin         String?
  dlNumber      String?
  phone         String?
  email         String?
  address       String?
  city          String?
  state         String?
  creditLimit   Decimal @default(0) @db.Decimal(12, 2)
  creditDays    Int     @default(30)
  paymentTerms  String?
  isActive      Boolean @default(true)
  // Running balance: incremented on GRN confirm, decremented on payment or supplier return.
  // Positive = pharmacy owes supplier; negative = supplier owes pharmacy (over-payment or credit).
  // Avoids two aggregate queries on every supplier list / balance badge read.
  ledgerBalance Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy        Pharmacy              @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  purchaseOrders  PurchaseOrder[]
  grns            GoodsReceiptNote[]
  supplierReturns SupplierReturn[]
  ledgerEntries   SupplierLedgerEntry[]
  quotations      Quotation[]

  @@index([pharmacyId])
  @@index([pharmacyId, isActive])
  @@map("suppliers")
}

// ─── Purchase Order ───────────────────────────────────────────────────────────

model PurchaseOrder {
  id              String         @id @default(cuid())
  pharmacyId      String
  supplierId      String
  orderNumber     String
  invoiceNo       String?
  status          PurchaseStatus @default(DRAFT)
  approvalStatus  ApprovalStatus @default(NOT_REQUIRED)
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  subtotal        Decimal        @default(0) @db.Decimal(12, 2)
  totalGst        Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal        @default(0) @db.Decimal(12, 2)
  notes           String?
  expectedDate    DateTime?
  orderedAt       DateTime       @default(now())
  receivedAt      DateTime?
  // Source PDF this PO was drafted from (e.g. supplier quote), if any — see Upload model.
  sourceUploadId  String?
  // Line items, denormalized as JSON — no cross-row aggregation/reporting ever
  // queries into this at the SQL level (verified before this migration), so a
  // child table bought nothing but an extra join. itemCount is maintained
  // alongside it so list views don't need to read/parse the JSON just to show
  // a count (mirrors Supplier.ledgerBalance's running-value pattern below).
  items           Json
  itemCount       Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy     Pharmacy           @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  supplier     Supplier           @relation(fields: [supplierId], references: [id])
  approver     User?              @relation("POApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  sourceUpload Upload?            @relation(fields: [sourceUploadId], references: [id], onDelete: SetNull)
  grns         GoodsReceiptNote[]

  @@unique([pharmacyId, orderNumber])
  @@index([pharmacyId, status])
  @@index([pharmacyId, supplierId])
  @@index([pharmacyId, approvalStatus])
  // Default PO list view: WHERE pharmacyId=? ORDER BY orderedAt DESC (no other filter).
  // Without this the list does a sort on every page load (mirrors the invoices list index).
  @@index([pharmacyId, orderedAt(sort: Desc)])
  @@map("purchase_orders")
}

enum PurchaseStatus {
  DRAFT
  PENDING
  RECEIVED
  PARTIAL
  CANCELLED
}

enum BatchStatus {
  ACTIVE
  QUARANTINE
  EXPIRED
  DAMAGED
}

// How the dispensing engine orders in-stock batches of one medicine (see
// DispensingService, Java). Only ACTIVE, in-date, sellable batches are ever
// candidates under either value — this only decides the order among those.
enum DispensingStrategy {
  // Last In, Last Available — earliest valid expiry first (a.k.a. FEFO). The
  // default: sells older stock before it expires and minimises write-offs.
  LILA_FEFO
  // Last In, First Available — most recently received batch first. Opt-in, for
  // pharmacies that deliberately want to move the freshest stock.
  LIFA
}

enum GRNStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

// PurchaseOrderItem removed — folded into PurchaseOrder.items (JSON) above.
// Verified before removal: the only direct table-level query against it was
// a deleteMany during PO edit; no report or cross-row aggregate ever read it.

// ─── Invoice ─────────────────────────────────────────────────────────────────

model Invoice {
  id             String        @id @default(cuid())
  pharmacyId     String
  invoiceNumber  String
  customerId     String?
  // Snapshot of customer name/phone at billing time — avoids JOIN in search queries
  // and preserves the name even if the customer record is later updated.
  customerName   String?
  customerPhone  String?
  userId         String
  doctorId       String?
  doctorName     String?
  // Snapshot doctor registration number at billing time so the audit trail
  // is self-contained even if the doctor record is later edited or deleted.
  doctorRegNo    String?
  prescriptionId String?
  paymentMode    PaymentMode   @default(CASH)
  paymentStatus  PaymentStatus @default(PAID)
  status         InvoiceStatus @default(COMPLETED)
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  taxableAmount  Decimal       @db.Decimal(12, 2)
  cgst           Decimal       @db.Decimal(12, 2)
  sgst           Decimal       @db.Decimal(12, 2)
  igst           Decimal       @default(0) @db.Decimal(12, 2)
  totalGst       Decimal       @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  // Bill-level additions, stored so the invoice can be re-derived from its own row:
  // taxableAmount + totalGst + extraCharges + adjustmentAmount + roundOff = totalAmount.
  // roundOff is signed — the rupee rounding goes either way and prints as its own line.
  extraCharges     Decimal     @default(0) @db.Decimal(12, 2)
  adjustmentAmount Decimal     @default(0) @db.Decimal(12, 2)
  roundOff         Decimal     @default(0) @db.Decimal(12, 2)
  returnedAmount Decimal       @default(0) @db.Decimal(12, 2)
  // Cached SUM(InvoicePayment.amount) for this bill, so a list view can show
  // balance-due without an aggregate per row. Balance = totalAmount -
  // returnedAmount - amountPaid. Moved in the same transaction as every
  // InvoicePayment insert.
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  isInterstate   Boolean       @default(false)
  notes          String?
  isCancelled    Boolean       @default(false)
  cancelledAt    DateTime?
  cancelReason   String?
  idempotencyKey String?
  // The batch-selection strategy in effect when this bill was created (see
  // DispensingService). Snapshotted so a later change to the pharmacy setting
  // never rewrites the audit trail of a past sale. NULL on rows created before
  // this column existed — "not recorded", not "no strategy".
  dispensingStrategy DispensingStrategy?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy     Pharmacy         @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  customer     Customer?        @relation(fields: [customerId], references: [id])
  doctor       Doctor?          @relation(fields: [doctorId], references: [id])
  user         User             @relation(fields: [userId], references: [id])
  prescription Prescription?    @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  items        InvoiceItem[]
  packSizeSignals PackSizeSignal[]
  payments     InvoicePayment[]
  returns      SalesReturn[]
  ledgerEntries CustomerLedgerEntry[]

  @@unique([pharmacyId, invoiceNumber])
  @@unique([pharmacyId, idempotencyKey])
  @@index([pharmacyId, createdAt])
  @@index([pharmacyId, customerId])
  @@index([pharmacyId, status])
  // Covering index for pending-credit queries: WHERE pharmacyId=? AND paymentStatus='PENDING' AND isCancelled=false
  @@index([pharmacyId, paymentStatus, isCancelled])
  // Covering index for filtered invoice list sorted by date (most common view)
  @@index([pharmacyId, isCancelled, createdAt(sort: Desc)])
  // Doctor-wise prescription report (full scan without this)
  @@index([pharmacyId, doctorId])
  // Cashier-wise billing report
  @@index([pharmacyId, userId])
  @@map("invoices")
}

// ─── Prescription ─────────────────────────────────────────────────────────────
// Structured prescription record linking a scanned upload to doctor + patient
// details and the list of drugs prescribed. Required for Schedule H / H1 / X
// drugs under the Drugs & Cosmetics Act before dispensing.

model Prescription {
  id                 String             @id @default(cuid())
  pharmacyId         String
  prescriptionNumber String
  externalEmrTenantId String?
  externalEmrPrescriptionId String?
  externalEmrPrescriptionNumber String?
  receivedAt         DateTime?
  /// Null until a pharmacist opens this prescription for the first time. Only meaningful
  /// for a clinic-sourced one (receivedAt set) — drives the "new prescription" nav badge.
  viewedAt           DateTime?
  doctorId           String?
  doctorName         String
  doctorRegNo        String? // MCI / state council registration number
  doctorPhone        String?
  patientName        String
  patientAge         Int?
  patientPhone       String?
  patientGender      String?
  uploadId           String? // scanned prescription image
  prescribedDate     DateTime?
  validUntil         DateTime?
  status             PrescriptionStatus @default(ACTIVE)
  notes              String?

  // Dispense callback to the clinic. NULL throughout means "never applied" — a
  // counter-written prescription, which is most of them.
  dispenseNotifyStatus        String?
  dispenseNotifiedAt          DateTime?
  dispenseNotifyError         String?
  dispenseNotifyAttempts      Int       @default(0)
  dispenseNotifyNextAttemptAt DateTime?

  // Cancellation callback to the clinic — the mirror direction of the dispense callback
  // above. NULL throughout means "never applied": either counter-written, or from a
  // clinic but never cancelled from this side.
  cancelNotifyStatus        String?
  cancelNotifiedAt          DateTime?
  cancelNotifyError         String?
  cancelNotifyAttempts      Int       @default(0)
  cancelNotifyNextAttemptAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy Pharmacy           @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  doctor   Doctor?            @relation(fields: [doctorId], references: [id])
  upload   Upload?            @relation(fields: [uploadId], references: [id])
  invoices Invoice[]
  items    PrescriptionItem[]

  @@unique([pharmacyId, prescriptionNumber])
  @@unique([pharmacyId, externalEmrTenantId, externalEmrPrescriptionId])
  @@index([pharmacyId, status])
  @@index([pharmacyId, doctorId])
  @@index([pharmacyId, createdAt])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String  @id @default(cuid())
  pharmacyId     String
  prescriptionId String
  externalEmrItemId String?
  medicineName   String
  medicineId     String?
  schedule       String? // H, H1, X, G, OTC
  quantity       Int
  dispensedQty   Int     @default(0)
  // True when `quantity` was derived from dosage + duration rather than sent by the clinic —
  // see PrescriptionQuantityCalculator (Java). Purely informational: nothing reads this to
  // decide behaviour, it only lets the triage screen label where the number came from.
  quantityAutoCalculated Boolean @default(false)
  // One line explaining HOW quantity was calculated, or WHY it couldn't be (still needing
  // manual confirmation) — see PrescriptionQuantityCalculator.Result. Null when neither
  // ever applied (an explicit clinic quantity, or an unmatched line).
  quantityCalculationNote String?
  // The clinical volume/weight the clinic prescribed for a MEASURED (ML/GM) line, kept
  // verbatim — drives the "Prescribed: 105 ml" display and the dosage line on the label.
  // Null for a countable line and for any line sent as a plain unit count.
  prescribedVolumeClinical Decimal? @db.Decimal(12, 2)
  // The unit `prescribedVolumeClinical` is in — "ML" | "GM". Null when there is no clinical
  // volume on the line.
  clinicalUom             String?
  // Whole sealed packs the measured course was rounded UP to once the medicine's pack size
  // is known: ceil(prescribedVolumeClinical / effectiveUnitsPerPack). Null while the pack
  // size is still unknown (the line is held for a pharmacist to enter a pack count) and for
  // every countable line. Display/label/audit only — `quantity` already holds the resolved
  // dispense target in base units (roundedPackCount * unitsPerPack).
  roundedPackCount        Int?
  // Set only when a substitute was handed over; NULL means "as prescribed".
  dispensedMedicineId   String?
  dispensedMedicineName String?
  dosage         String?
  duration       String?
  notes          String?

  createdAt DateTime @default(now())

  pharmacy     Pharmacy     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine     Medicine?    @relation(fields: [medicineId], references: [id])

  @@unique([prescriptionId, externalEmrItemId])
  @@index([pharmacyId])
  @@index([prescriptionId])
  @@map("prescription_items")
}

enum PrescriptionStatus {
  ACTIVE
  PARTIAL
  DISPENSED
  EXPIRED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  COMPLETED
  CANCELLED
  RETURNED
  PARTIALLY_RETURNED
}

enum PaymentMode {
  CASH
  UPI
  CARD
  CREDIT
  WALLET
}

enum PaymentStatus {
  PAID
  PENDING
  PARTIAL
}

model InvoiceItem {
  id            String   @id @default(cuid())
  pharmacyId    String
  invoiceId     String
  inventoryId   String
  medicineName  String
  hsnCode       String?
  batchNumber   String
  expiryDate    DateTime
  quantity      Int
  // PACK (default, every legacy row) — quantity is whole strips/bottles; mrp/rate
  // are the printed pack price. LOOSE — quantity is individual pieces cut from a
  // strip; mrp/rate are per-piece (pack MRP / unitsPerPack) and the batch was
  // decremented in pieces. batch/expiry are still carried on a loose line.
  saleUnit      String   @default("PACK")
  // Snapshot of the medicine's base unit at sale time (TABLET|CAPSULE|ML|GM|EACH),
  // for the "8 tab" label on a re-printed bill. Only set for a LOOSE line.
  baseUnit      String?
  // Scheme quantity handed over free with this line (10+1, buy-100-get-10).
  // NOT charged: taxableAmount/amount are derived from `quantity` alone. It IS
  // deducted from stock, because the goods physically leave the shelf — the batch
  // is decremented by quantity + freeQty.
  freeQty       Int      @default(0)
  mrp           Decimal  @db.Decimal(12, 2)
  rate          Decimal  @db.Decimal(12, 2)
  purchaseRate  Decimal  @default(0) @db.Decimal(12, 2)
  discount      Decimal  @default(0) @db.Decimal(12, 2)
  gstRate       Decimal  @db.Decimal(12, 2)
  cgst          Decimal  @db.Decimal(12, 2)
  sgst          Decimal  @db.Decimal(12, 2)
  igst          Decimal  @default(0) @db.Decimal(12, 2)
  taxableAmount Decimal  @db.Decimal(12, 2)
  amount        Decimal  @db.Decimal(12, 2)
  location      String?
  // true — the dispensing engine chose this batch under the invoice's strategy.
  // false — a pharmacist overrode it in the batch picker. Part of the dispensing
  // audit trail alongside Invoice.dispensingStrategy. Defaults true: every legacy
  // row predates the picker's override flag and was effectively engine order.
  batchAutoSelected Boolean @default(true)

  pharmacy         Pharmacy          @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  invoice          Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  inventory        Inventory         @relation(fields: [inventoryId], references: [id])
  salesReturnItems SalesReturnItem[]

  @@index([pharmacyId])
  @@index([invoiceId])
  @@index([inventoryId])
  @@map("invoice_items")
}

// ─── Invoice Payments (split payment support) ────────────────────────────────

model InvoicePayment {
  id          String      @id @default(cuid())
  pharmacyId  String
  invoiceId   String
  amount      Decimal     @db.Decimal(12, 2)
  paymentMode PaymentMode
  reference   String?
  notes       String?
  paidAt      DateTime    @default(now())
  createdBy   String

  pharmacy      Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdByUser User     @relation(fields: [createdBy], references: [id])

  @@index([invoiceId])
  @@index([pharmacyId, paidAt])
  @@map("invoice_payments")
}

// ─── Sales Return ─────────────────────────────────────────────────────────────

model SalesReturn {
  id             String  @id @default(cuid())
  pharmacyId     String
  invoiceId      String
  returnNumber   String
  reason         String?
  userId         String
  customerId     String?
  subtotal       Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxableAmount  Decimal @db.Decimal(12, 2)
  cgst           Decimal @db.Decimal(12, 2)
  sgst           Decimal @db.Decimal(12, 2)
  igst           Decimal @default(0) @db.Decimal(12, 2)
  totalGst       Decimal @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)
  idempotencyKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pharmacy Pharmacy          @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  invoice  Invoice           @relation(fields: [invoiceId], references: [id])
  user     User              @relation(fields: [userId], references: [id])
  customer      Customer?             @relation(fields: [customerId], references: [id])
  items         SalesReturnItem[]
  ledgerEntries CustomerLedgerEntry[]

  @@unique([pharmacyId, returnNumber])
  @@unique([pharmacyId, idempotencyKey])
  @@index([pharmacyId, invoiceId])
  @@index([pharmacyId, createdAt])
  @@map("sales_returns")
}

enum ReturnDisposition {
  RESTOCK
  WRITEOFF
}

model SalesReturnItem {
  id            String            @id @default(cuid())
  pharmacyId    String
  returnId      String
  invoiceItemId String?
  inventoryId   String
  medicineName  String
  hsnCode       String?
  batchNumber   String
  expiryDate    DateTime
  quantity      Int
  mrp           Decimal           @db.Decimal(12, 2)
  rate          Decimal           @db.Decimal(12, 2)
  discount      Decimal           @default(0) @db.Decimal(12, 2)
  gstRate       Decimal           @db.Decimal(12, 2)
  cgst          Decimal           @db.Decimal(12, 2)
  sgst          Decimal           @db.Decimal(12, 2)
  igst          Decimal           @default(0) @db.Decimal(12, 2)
  taxableAmount Decimal           @db.Decimal(12, 2)
  amount        Decimal           @db.Decimal(12, 2)
  disposition   ReturnDisposition @default(RESTOCK)

  pharmacy    Pharmacy     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  return      SalesReturn  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  inventory   Inventory    @relation(fields: [inventoryId], references: [id])
  invoiceItem InvoiceItem? @relation(fields: [invoiceItemId], references: [id], onDelete: SetNull)

  @@index([pharmacyId])
  @@index([returnId])
  @@index([inventoryId])
  @@index([invoiceItemId])
  @@map("sales_return_items")
}

// ─── Inventory Movement (full stock ledger) ───────────────────────────────────
// Append-only. Every stock change writes one record here for full reconciliation.

model InventoryMovement {
  id             String            @id @default(cuid())
  pharmacyId     String
  inventoryId    String
  userId         String
  type           MovementType
  direction      MovementDirection
  quantity       Int
  quantityBefore Int
  quantityAfter  Int
  // Valid values (enforced by DB CHECK): GRN | INVOICE | INVOICE_CANCEL | SALES_RETURN |
  // SUPPLIER_RETURN | BATCH_RECALL | STATUS_CHANGE | STOCK_AUDIT |
  // CORRECTION | DAMAGE | EXPIRY_WRITEOFF | OPENING_BALANCE | TRANSFER | THEFT | BREAKAGE | STOCK_COUNT | OTHER
  referenceType  String?
  referenceId    String?
  notes          String?
  // Set only on a loose (cut-strip) movement: the base unit ("TABLET" | "CAPSULE" |
  // "ML" | "GM" | "EACH") that quantity/quantityBefore/quantityAfter are counted in
  // for THIS row. NULL everywhere else (and on every legacy row) means the row is in
  // whole packs, exactly as before. Lets the ledger label each row and lets sales-
  // velocity fold pack and piece rows onto one scale.
  baseUnit       String?

  createdAt DateTime @default(now())

  pharmacy  Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  inventory Inventory @relation(fields: [inventoryId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([pharmacyId, inventoryId])
  @@index([pharmacyId, createdAt])
  @@index([referenceId])
  // Covering index for ledger filtered by movement type (sale/purchase/adjustment history views)
  @@index([pharmacyId, type, createdAt(sort: Desc)])
  // User-wise stock movement audit
  @@index([pharmacyId, userId, createdAt(sort: Desc)])
  // AI sales-velocity: getMedicineDailySales JOINs on inventoryId then filters
  // direction+type+createdAt — without this Postgres scans all movements per batch.
  @@index([inventoryId, direction, type, createdAt(sort: Desc)])
  @@map("inventory_movements")
}

enum MovementType {
  SALE
  RETURN
  PURCHASE
  ADJUSTMENT
  OPENING
  DAMAGE
  EXPIRY_REMOVAL
}

enum MovementDirection {
  IN
  OUT
}

// InvoiceSettings table removed — inlined into Pharmacy.invoiceSettings (Json).
// Was a strict 1:1 (pharmacyId @unique) holding one JSON blob, read only by
// pharmacyId and written via upsert; a separate table added a join for nothing.

// ─── Audit Log ───────────────────────────────────────────────────────────────

enum AuditModule {
  AUTH
  TENANTS
  SUBSCRIPTIONS
  SUPPORT
  SETTINGS
  SYSTEM
  ANALYTICS
  AUDIT
  BILLING
  INVENTORY
}

enum AuditSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum AuditStatus {
