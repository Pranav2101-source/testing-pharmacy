  },
  "dependencies": {
    "@prisma/client": "^5.19.0"
  },
  "devDependencies": {
    "prisma": "^5.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "bcryptjs": "^2.4.3",
    "@types/bcryptjs": "^2.4.6",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "meilisearch": "^0.44.0"
